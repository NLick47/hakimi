import { ScrollView } from "std-widgets.slint";

export struct DomainEntry {
    host: string,
    status: string,
    status-color: color,
    latency: string,
}

export struct SiteEntry {
    id: string,
    name: string,
    icon: image,
    initial: string,
    tile-color: color,
    summary: string,
    enabled: bool,
    open: bool,
    url: string,
    domains: [DomainEntry],
}

export struct SettingsEntry {
    title: string,
    subtitle: string,
    icon-kind: int,
}

// -- custom controls ---------------------------------------------------------

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> emphasis: true;
    callback clicked();

    height: 32px;
    min-width: 92px;
    border-radius: 8px;
    border-width: emphasis ? 0px : 1px;
    border-color: emphasis ? transparent : rgba(24, 119, 210, 0.45);
    background: emphasis
        ? (touch.pressed ? #0E5EAE : touch.has-hover ? #146EC8 : #1877D2)
        : (touch.pressed ? rgba(24, 119, 210, 0.14) : touch.has-hover ? rgba(24, 119, 210, 0.08) : transparent);
    animate background { duration: 120ms; }

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 500;
        color: emphasis ? #FFFFFF : #1877D2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component StatusBadge inherits Rectangle {
    in property <bool> active;

    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: active ? rgba(24, 119, 210, 0.10) : rgba(108, 123, 138, 0.10);
    animate background { duration: 160ms; }

    Path {
        width: 19px;
        height: 19px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 14.6 5.3 A 6.8 6.8 0 1 1 4.4 5.3 M 9.5 1.6 L 9.5 9.5";
        stroke: active ? #1877D2 : #7A8794;
        stroke-width: 1.8px;
        animate stroke { duration: 160ms; }
    }
}

component BackIcon inherits Rectangle {
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: touch.has-hover ? rgba(24, 119, 210, 0.09) : transparent;
    animate background { duration: 120ms; }

    Path {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 10 3 L 4.5 8 L 10 13";
        stroke: #1877D2;
        stroke-width: 1.7px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component CheckSquare inherits Rectangle {
    in property <bool> checked;
    callback toggled();

    width: 18px;
    height: 18px;
    border-radius: 5px;
    border-width: 1.3px;
    border-color: checked || touch.has-hover ? #1877D2 : #98A4B0;
    background: checked ? #1877D2 : #FFFFFF;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    Path {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 1 5.4 L 4 8.2 L 9 2.4";
        stroke: #FFFFFF;
        stroke-width: 1.8px;
        opacity: checked ? 1 : 0;
        animate opacity { duration: 130ms; }
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

component Chevron inherits Rectangle {
    in property <bool> open;
    width: 12px;
    height: 12px;

    if !open: Path {
        width: 12px;
        height: 12px;
        commands: "M 4 2.5 L 8.5 7 L 4 11.5";
        stroke: #9AA5B1;
        stroke-width: 1.5px;
    }
    if open: Path {
        width: 12px;
        height: 12px;
        commands: "M 2.5 4 L 7 8.5 L 11.5 4";
        stroke: #7A8794;
        stroke-width: 1.5px;
    }
}

component GearIcon inherits Rectangle {
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: touch.has-hover ? rgba(24, 119, 210, 0.09) : transparent;
    animate background { duration: 120ms; }

    // cog: body circle + short stub teeth (not rays) + inner hole
    Path {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 14 9 A 5 5 0 1 0 4 9 A 5 5 0 1 0 14 9 M 11 9 A 2 2 0 1 0 7 9 A 2 2 0 1 0 11 9";
        stroke: touch.has-hover ? #1877D2 : #6B7684;
        stroke-width: 1.5px;
        animate stroke { duration: 120ms; }
    }
    Path {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 14 9 L 15.6 9 M 12.54 12.54 L 13.7 13.7 M 9 14 L 9 15.6 M 5.46 12.54 L 4.3 13.7 M 4 9 L 2.4 9 M 5.46 5.46 L 4.3 4.3 M 9 4 L 9 2.4 M 12.54 5.46 L 13.7 4.3";
        stroke: touch.has-hover ? #1877D2 : #6B7684;
        stroke-width: 2.2px;
        animate stroke { duration: 120ms; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TextButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 26px;
    min-width: 40px;
    border-radius: 6px;
    background: touch.has-hover ? rgba(24, 119, 210, 0.07) : transparent;
    animate background { duration: 120ms; }

    Text {
        text: root.label;
        font-size: 12.5px;
        color: touch.has-hover ? #1877D2 : #6B7684;
        animate color { duration: 120ms; }
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SettingsRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <int> icon-kind;
    height: 56px;
    border-radius: 10px;
    background: touch.has-hover ? rgba(255, 255, 255, 0.92) : rgba(255, 255, 255, 0.6);
    border-width: 0.5px;
    border-color: rgba(140, 160, 180, 0.28);
    animate background { duration: 130ms; }

    HorizontalLayout {
        padding: 11px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 13px;

        Rectangle {
            width: 34px;
            border-radius: 9px;
            background: rgba(24, 119, 210, 0.1);

            Rectangle {
                width: 17px;
                height: 17px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                if root.icon-kind == 0: Path {
                    commands: "M 15 8.5 A 6 6 0 1 0 3 8.5 A 6 6 0 1 0 15 8.5 M 3 8.5 L 15 8.5 M 9 2.5 C 6.5 5 6.5 12 9 14.5 M 9 2.5 C 11.5 5 11.5 12 9 14.5";
                    stroke: #1877D2;
                    stroke-width: 1.2px;
                }
                if root.icon-kind == 1: Rectangle {
                    y: 7px;
                    width: 11px;
                    height: 9px;
                    border-radius: 2px;
                    border-width: 1.3px;
                    border-color: #1877D2;
                }
                if root.icon-kind == 1: Path {
                    commands: "M 5.5 8 L 5.5 5.5 A 3 3 0 0 1 11.5 5.5 L 11.5 8";
                    stroke: #1877D2;
                    stroke-width: 1.3px;
                }
                if root.icon-kind == 2: Rectangle {
                    x: 0;
                    y: 2px;
                    width: 7px;
                    height: 13px;
                    border-radius: 2px;
                    border-width: 1.3px;
                    border-color: #1877D2;
                }
                if root.icon-kind == 2: Rectangle {
                    x: 9px;
                    y: 2px;
                    width: 7px;
                    height: 13px;
                    border-radius: 2px;
                    border-width: 1.3px;
                    border-color: rgba(24, 119, 210, 0.45);
                }
                if root.icon-kind == 3: Path {
                    commands: "M 2 4.5 A 7 2.4 0 1 0 16 4.5 A 7 2.4 0 1 0 2 4.5 M 2 4.5 L 2 12.5 C 2 13.9 4.7 15 9 15 C 13.3 15 16 13.9 16 12.5 L 16 4.5 M 2 8.5 C 2 9.9 4.7 11 9 11 C 13.3 11 16 9.9 16 8.5";
                    stroke: #1877D2;
                    stroke-width: 1.1px;
                }
                if root.icon-kind == 4: Path {
                    commands: "M 15.5 9 A 6.5 6.5 0 1 0 2.5 9 A 6.5 6.5 0 1 0 15.5 9 M 9 8.2 L 9 12.4 M 9 5.4 L 9 5.6";
                    stroke: #1877D2;
                    stroke-width: 1.4px;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: root.title;
                font-size: 13.5px;
                color: #1A1A1A;
            }
            Text {
                text: root.subtitle;
                font-size: 11.5px;
                color: #8A95A2;
            }
        }

        Rectangle {
            width: 12px;
            height: parent.height;
            Chevron { y: (parent.height - self.height) / 2; open: false; }
        }
    }

    touch := TouchArea {
        clicked => { }
    }
}

// -- app window --------------------------------------------------------------

export component AppWindow inherits Window {
    title: "hakimi";
    width: 540px;
    height: 600px;
    background: @linear-gradient(165deg, #D7E3EE 0%, #DCE6F0 100%);

    in property <[SiteEntry]> sites;
    in property <[SettingsEntry]> settings;
    in property <string> status-subtitle: "正在启动";
    in property <bool> running: false;
    in-out property <int> page: 0;

    callback toggle-master();
    callback toggle-group(string, bool);
    callback select-all(bool);
    callback probe-all();
    callback open-site(string);
    callback toggle-open(string);

    VerticalLayout {

        // header
        Rectangle {
            height: 48px;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 12px;
                spacing: 8px;

                // left: logo (home) or back (settings)
                Rectangle {
                    width: 28px;
                    height: parent.height;

                    if root.page == 0: Rectangle {
                        width: 24px;
                        height: 24px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 7px;
                        background: #1877D2;

                        Path {
                            width: 13px;
                            height: 13px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            commands: "M 7.6 0.8 L 2.2 7.6 L 5.9 7.6 L 5 12.4 L 10.8 5.2 L 6.9 5.2 Z";
                            fill: #FFFFFF;
                        }
                    }

                    if root.page == 1: BackIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.page = 0; }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: root.page == 0 ? "hakimi" : "设置";
                        font-size: 14.5px;
                        font-weight: 500;
                        color: #1A1A1A;
                    }
                }

                // right: gear (home only)
                Rectangle {
                    width: 32px;
                    height: parent.height;

                    if root.page == 0: GearIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.page = 1; }
                    }
                }
            }
        }

        if root.page == 0: VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 14px;
            spacing: 0px;

            // acceleration status / primary action
            Rectangle {
                height: 80px;
                background: rgba(255, 255, 255, 0.82);
                border-radius: 12px;
                border-width: 0.5px;
                border-color: rgba(140, 160, 180, 0.25);

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;

                    // badge cell, fixed center
                    Rectangle {
                        width: 40px;
                        height: parent.height;
                        StatusBadge {
                            y: (parent.height - self.height) / 2;
                            active: root.running;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 3px;

                        Text {
                            text: root.running ? "加速已开启" : "加速未开启";
                            font-size: 15.5px;
                            font-weight: 600;
                            color: #1A1A1A;
                        }
                        Text {
                            text: root.status-subtitle;
                            font-size: 12.5px;
                            color: #7A8794;
                            overflow: elide;
                        }
                    }

                    // action cell, fixed center
                    Rectangle {
                        width: 96px;
                        height: parent.height;
                        ActionButton {
                            width: parent.width;
                            y: (parent.height - self.height) / 2;
                            label: root.running ? "停止加速" : "开启加速";
                            emphasis: !root.running;
                            clicked => { root.toggle-master(); }
                        }
                    }
                }
            }

            // section header
            Rectangle {
                height: 40px;

                HorizontalLayout {
                    padding-left: 2px;
                    padding-right: 2px;
                    padding-top: 10px;
                    padding-bottom: 4px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "站点";
                            font-size: 13px;
                            font-weight: 500;
                            color: #4A5560;
                        }
                    }

                    HorizontalLayout {
                        spacing: 0px;
                        TextButton { label: "测速"; min-width: 44px; clicked => { root.probe-all(); } }
                        TextButton { label: "全选"; min-width: 44px; clicked => { root.select-all(true); } }
                        TextButton { label: "清除"; min-width: 44px; clicked => { root.select-all(false); } }
                    }
                }
            }

            // site list
            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 7px;
                    alignment: start;

                    for site in root.sites: Rectangle {
                        background: site.open ? #FFFFFF : rgba(255, 255, 255, 0.72);
                        border-radius: 10px;
                        border-width: 0.5px;
                        border-color: site.open ? rgba(24, 119, 210, 0.35) : rgba(140, 160, 180, 0.28);
                        clip: true;
                        animate background { duration: 140ms; }
                        animate border-color { duration: 140ms; }

                        VerticalLayout {
                            // header row: every control sits in a full-height cell,
                            // centered explicitly so nothing drifts
                            Rectangle {
                                height: 52px;
                                background: header-touch.has-hover && !site.open ? rgba(24, 119, 210, 0.025) : transparent;
                                animate background { duration: 120ms; }

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 12px;
                                    spacing: 10px;

                                    // checkbox cell
                                    Rectangle {
                                        width: 18px;
                                        height: parent.height;
                                        CheckSquare {
                                            y: (parent.height - self.height) / 2;
                                            checked: site.enabled;
                                            toggled => { root.toggle-group(site.id, !site.enabled); }
                                        }
                                    }

                                    // icon tile cell
                                    Rectangle {
                                        width: 30px;
                                        height: parent.height;

                                        Rectangle {
                                            width: 30px;
                                            height: 30px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 8px;
                                            background: site.icon.width > 0 ? #FFFFFF : site.tile-color;
                                            border-width: 0.5px;
                                            border-color: site.icon.width > 0 ? rgba(120, 140, 160, 0.25) : transparent;
                                            clip: true;

                                            if site.icon.width > 0: Image {
                                                width: 20px;
                                                height: 20px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                source: site.icon;
                                            }
                                            if site.icon.width == 0: Text {
                                                text: site.initial;
                                                font-size: 13.5px;
                                                font-weight: 500;
                                                color: #FFFFFF;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // name + summary
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: site.name;
                                            font-size: 13.5px;
                                            font-weight: 500;
                                            color: #1A1A1A;
                                        }
                                        Text {
                                            text: site.summary;
                                            font-size: 11.5px;
                                            color: #8A95A2;
                                            overflow: elide;
                                        }
                                    }

                                    // open-in-browser cell
                                    Rectangle {
                                        width: 44px;
                                        height: parent.height;
                                        TextButton {
                                            width: parent.width;
                                            y: (parent.height - self.height) / 2;
                                            label: "访问";
                                            clicked => { root.open-site(site.url); }
                                        }
                                    }

                                    // chevron cell
                                    Rectangle {
                                        width: 12px;
                                        height: parent.height;
                                        Chevron {
                                            y: (parent.height - self.height) / 2;
                                            open: site.open;
                                        }
                                    }
                                }

                                header-touch := TouchArea {
                                    clicked => { root.toggle-open(site.id); }
                                }
                            }

                            // expanded domain list
                            if site.open: Rectangle {
                                height: site.domains.length * 28px + 1px;
                                background: transparent;

                                VerticalLayout {
                                    Rectangle { height: 1px; background: rgba(140, 160, 180, 0.18); }

                                    for d in site.domains: Rectangle {
                                        height: 28px;

                                        HorizontalLayout {
                                            // 14 + 18 + 10 = 42 aligns with the icon tile's left edge
                                            padding-left: 72px;
                                            padding-right: 16px;
                                            spacing: 8px;

                                            Text {
                                                text: d.host;
                                                horizontal-stretch: 1;
                                                font-size: 12px;
                                                font-family: "Menlo";
                                                color: #525E6A;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: d.status;
                                                width: 44px;
                                                font-size: 11.5px;
                                                color: d.status-color;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: d.latency;
                                                width: 56px;
                                                font-size: 11.5px;
                                                font-family: "Menlo";
                                                color: #7A8794;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 4px; }
                }
            }
        }

        if root.page == 1: VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 14px;
            padding-top: 6px;

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 7px;
                    alignment: start;

                    for entry in root.settings: SettingsRow {
                        title: entry.title;
                        subtitle: entry.subtitle;
                        icon-kind: entry.icon-kind;
                    }

                    Rectangle { height: 4px; }
                }
            }
        }
    }
}
