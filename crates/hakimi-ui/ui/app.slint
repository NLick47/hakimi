import { ScrollView } from "std-widgets.slint";

// Desktop-native palette: neutral window, solid surfaces, hairline borders.
// No gradients, no translucency, small radii.

export struct DomainEntry {
    host: string,
    status: string,
    status-color: color,
    latency: string,
}

export struct SiteEntry {
    id: string,
    name: string,
    icon: image,
    initial: string,
    tile-color: color,
    summary: string,
    enabled: bool,
    open: bool,
    first: bool,
    last: bool,
    url: string,
    domains: [DomainEntry],
}

export struct SettingsEntry {
    title: string,
    subtitle: string,
    icon-kind: int,
    action-label: string,
    action-kind: int,
    action-tone: int,
    first: bool,
    last: bool,
}

export component AlreadyRunningWindow inherits Window {
    title: "hakimi";
    width: 340px;
    height: 120px;
    background: #FFFFFF;

    VerticalLayout {
        alignment: center;
        spacing: 6px;

        Text {
            text: "hakimi 已经在运行";
            font-size: 14px;
            font-weight: 600;
            color: #1B1F24;
            horizontal-alignment: center;
        }
        Text {
            text: "请使用已打开的窗口";
            font-size: 12px;
            color: #6B7480;
            horizontal-alignment: center;
        }
    }
}

// -- controls ----------------------------------------------------------------

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> emphasis: true;
    callback clicked();

    height: 32px;
    min-width: 92px;
    border-radius: 6px;
    border-width: emphasis ? 0px : 1px;
    border-color: emphasis ? transparent : #D6DBE0;
    background: emphasis
        ? (touch.pressed ? #005BA6 : touch.has-hover ? #0B72BE : #0067C0)
        : (touch.pressed ? #ECEEF0 : touch.has-hover ? #F2F4F6 : #FFFFFF);
    animate background { duration: 100ms; }

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 400;
        color: emphasis ? #FFFFFF : #C0392B;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PowerBadge inherits Rectangle {
    in property <bool> active;

    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: active ? #0067C0 : #E9ECEF;

    Path {
        width: 17px;
        height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 13.2 4.8 A 6.2 6.2 0 1 1 4.8 4.8 M 9 1.5 L 9 8.8";
        stroke: active ? #FFFFFF : #6B7680;
        stroke-width: 1.7px;
        stroke-line-cap: round;
    }
}

component BackIcon inherits Rectangle {
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 5px;
    background: touch.has-hover ? #E9EBEE : transparent;
    animate background { duration: 100ms; }

    Path {
        width: 15px;
        height: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 9.5 3 L 4.5 7.5 L 9.5 12";
        stroke: #3B434C;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component CheckSquare inherits Rectangle {
    in property <bool> checked;
    callback toggled();

    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: 1px;
    border-color: checked || touch.has-hover ? #0067C0 : #9AA3AC;
    background: checked ? #0067C0 : #FFFFFF;
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    Path {
        width: 9px;
        height: 9px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 1 4.9 L 3.7 7.4 L 8 2.2";
        stroke: #FFFFFF;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
        opacity: checked ? 1 : 0;
        animate opacity { duration: 100ms; }
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

component Chevron inherits Rectangle {
    in property <bool> open;
    width: 10px;
    height: 10px;

    Path {
        width: 10px;
        height: 10px;
        commands: "M 3.8 2.2 L 7.8 5.8 L 3.8 9.4";
        stroke: root.open ? #5C6670 : #98A1AB;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        opacity: root.open ? 0 : 1;
        animate opacity { duration: 120ms; }
    }
    Path {
        width: 10px;
        height: 10px;
        commands: "M 2.2 3.8 L 5.4 6.8 L 8.6 3.8";
        stroke: #5C6670;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: 120ms; }
    }
}

component GearIcon inherits Rectangle {
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 5px;
    background: touch.has-hover ? #E9EBEE : transparent;
    animate background { duration: 100ms; }

    Path {
        width: 17px;
        height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 13.2 8.5 A 4.7 4.7 0 1 0 3.8 8.5 A 4.7 4.7 0 1 0 13.2 8.5 M 10.4 8.5 A 1.9 1.9 0 1 0 6.6 8.5 A 1.9 1.9 0 1 0 10.4 8.5";
        stroke: touch.has-hover ? #3B434C : #5C6670;
        stroke-width: 1.4px;
        animate stroke { duration: 100ms; }
    }
    Path {
        width: 17px;
        height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 13.2 8.5 L 14.7 8.5 M 11.9 11.8 L 13 12.9 M 8.5 13.2 L 8.5 14.7 M 5.1 11.8 L 4 12.9 M 3.8 8.5 L 2.3 8.5 M 5.1 5.2 L 4 4.1 M 8.5 3.8 L 8.5 2.3 M 11.9 5.2 L 13 4.1";
        stroke: touch.has-hover ? #3B434C : #5C6670;
        stroke-width: 2px;
        stroke-line-cap: round;
        animate stroke { duration: 100ms; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TextButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 24px;
    min-width: 40px;
    border-radius: 5px;
    background: touch.has-hover ? #E9EBEE : transparent;
    animate background { duration: 100ms; }

    Text {
        text: root.label;
        font-size: 12.5px;
        color: touch.has-hover ? #0067C0 : #5C6670;
        animate color { duration: 100ms; }
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// -- app window --------------------------------------------------------------

export component AppWindow inherits Window {
    title: "hakimi";
    width: 540px;
    height: 640px;
    background: #F3F4F5;

    in property <[SiteEntry]> sites;
    in property <[SettingsEntry]> settings;
    in property <string> status-subtitle: "正在启动";
    in property <bool> running: false;
    in-out property <int> page: 0;
    // Environment check (CA trust + system proxy). The fix page takes over the
    // window until everything passes; the main page shows a warning banner too.
    in-out property <bool> show-onboarding: false;
    in property <bool> ca-installed: false;
    in property <string> ca-error;
    in property <bool> proxy-ok: true;
    in-out property <bool> ob-installing: false;

    callback toggle-master();
    callback finish-onboarding();
    callback reapply-proxy();
    callback toggle-group(string, bool);
    callback select-all(bool);
    callback probe-all();
    callback open-site(string);
    callback toggle-open(string);
    callback settings-action(int);

    VerticalLayout {
        spacing: 0px;

        // ---- toolbar ----
        if !root.show-onboarding: Rectangle {
            height: 42px;
            background: #F3F4F5;

            Rectangle {
                width: parent.width;
                height: 1px;
                y: parent.height - 1px;
                background: #E1E4E8;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 10px;
                spacing: 9px;

                Rectangle {
                    width: 28px;
                    height: parent.height;

                    if root.page == 0: Rectangle {
                        width: 20px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        background: #0067C0;

                        Path {
                            width: 11px;
                            height: 11px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            commands: "M 6.6 0.5 L 1.8 6.2 L 4.9 6.2 L 4.1 10.5 L 9.1 4.3 L 5.7 4.3 Z";
                            fill: #FFFFFF;
                        }
                    }

                    if root.page == 1: BackIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.page = 0; }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    if root.page == 1: Text {
                        text: "设置";
                        font-size: 13.5px;
                        color: #1B1F24;
                    }
                }

                Rectangle {
                    width: 30px;
                    height: parent.height;

                    if root.page == 0: GearIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.page = 1; }
                    }
                }
            }
        }

        if !root.show-onboarding && root.page == 0: VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 18px;
            padding-bottom: 16px;
            spacing: 0px;

            // ---- environment warning ----
            if !root.ca-installed || !root.proxy-ok: Rectangle {
                height: 38px;
                background: #FFF6E5;
                border-radius: 6px;
                border-width: 1px;
                border-color: #F0DFC0;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "环境检查未通过：部分加速可能不生效";
                        font-size: 12px;
                        color: #8A6116;
                        horizontal-stretch: 1;
                    }
                    TextButton {
                        label: "去修复";
                        clicked => { root.show-onboarding = true; }
                    }
                }
            }
            if !root.ca-installed || !root.proxy-ok: Rectangle { height: 10px; }

            // ---- status ----
            Rectangle {
                height: 76px;
                background: #FFFFFF;
                border-radius: 8px;
                border-width: 1px;
                border-color: #E1E4E8;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 12px;

                    Rectangle {
                        width: 36px;
                        height: parent.height;
                        PowerBadge {
                            y: (parent.height - self.height) / 2;
                            active: root.running;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 3px;

                        Text {
                            text: root.running ? "加速已开启" : "加速已暂停";
                            font-size: 14.5px;
                            color: #1B1F24;
                        }
                        Text {
                            text: root.status-subtitle;
                            font-size: 12px;
                            color: #6B7480;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 96px;
                        height: parent.height;
                        ActionButton {
                            width: parent.width;
                            y: (parent.height - self.height) / 2;
                            label: root.running ? "停止加速" : "开启加速";
                            emphasis: !root.running;
                            clicked => { root.toggle-master(); }
                        }
                    }
                }
            }

            // ---- section header ----
            Rectangle {
                height: 40px;

                HorizontalLayout {
                    padding-left: 1px;
                    padding-right: 1px;
                    padding-top: 14px;
                    padding-bottom: 5px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "站点";
                            font-size: 12.5px;
                            color: #5C6670;
                        }
                    }

                    HorizontalLayout {
                        spacing: 2px;
                        TextButton { label: "测速"; min-width: 42px; clicked => { root.probe-all(); } }
                        TextButton { label: "全选"; min-width: 42px; clicked => { root.select-all(true); } }
                        TextButton { label: "清除"; min-width: 42px; clicked => { root.select-all(false); } }
                    }
                }
            }

            // ---- grouped site list ----
            site-scroll := ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                    spacing: 0px;
                    alignment: start;

                    Rectangle {
                        border-radius: 8px;
                        background: #FFFFFF;
                        border-width: 1px;
                        border-color: #E1E4E8;
                        clip: true;

                        VerticalLayout {
                            spacing: 0px;

                            for site in root.sites: Rectangle {
                                background: site.open ? #FAFBFC
                                    : (row-touch.has-hover ? #F4F6F8 : #FFFFFF);
                                animate background { duration: 100ms; }

                                VerticalLayout {
                                    spacing: 0px;

                                    // separator above the row (skip the first one)
                                    if !site.first: Rectangle {
                                        height: 1px;
                                        background: transparent;

                                        Rectangle {
                                            x: 76px;
                                            width: parent.width - 76px;
                                            height: parent.height;
                                            background: #ECEEF0;
                                        }
                                    }

                                    // row
                                    Rectangle {
                                        height: 50px;

                                        // below the layout so the checkbox and the
                                        // 访问 button keep their own clicks
                                        row-touch := TouchArea {
                                            clicked => { root.toggle-open(site.id); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 12px;
                                            spacing: 10px;

                                            Rectangle {
                                                width: 16px;
                                                height: parent.height;
                                                CheckSquare {
                                                    y: (parent.height - self.height) / 2;
                                                    checked: site.enabled;
                                                    toggled => { root.toggle-group(site.id, !site.enabled); }
                                                }
                                            }

                                            Rectangle {
                                                width: 26px;
                                                height: parent.height;

                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 6px;
                                                    background: site.icon.width > 0 ? #FFFFFF : site.tile-color;
                                                    border-width: 1px;
                                                    border-color: site.icon.width > 0 ? #E4E7EA : transparent;
                                                    clip: true;

                                                    if site.icon.width > 0: Image {
                                                        width: 17px;
                                                        height: 17px;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        source: site.icon;
                                                    }
                                                    if site.icon.width == 0: Text {
                                                        text: site.initial;
                                                        font-size: 12px;
                                                        color: #FFFFFF;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;

                                                Text {
                                                    text: site.name;
                                                    font-size: 13px;
                                                    color: #1B1F24;
                                                }
                                                Text {
                                                    text: site.summary;
                                                    font-size: 11.5px;
                                                    color: #6B7480;
                                                    overflow: elide;
                                                }
                                            }

                                            Rectangle {
                                                width: 42px;
                                                height: parent.height;
                                                TextButton {
                                                    width: parent.width;
                                                    y: (parent.height - self.height) / 2;
                                                    label: "访问";
                                                    clicked => { root.open-site(site.url); }
                                                }
                                            }

                                            Rectangle {
                                                width: 10px;
                                                height: parent.height;
                                                Chevron {
                                                    y: (parent.height - self.height) / 2;
                                                    open: site.open;
                                                }
                                            }
                                        }
                                    }

                                    // expanded domains: always present, animated
                                    // between zero height and full height
                                    Rectangle {
                                        height: site.open ? site.domains.length * 26px + 1px : 0px;
                                        clip: true;
                                        background: #FAFBFC;
                                        animate height { duration: 200ms; easing: ease-out; }

                                        VerticalLayout {
                                            spacing: 0px;

                                            Rectangle { height: 1px; background: #ECEEF0; }

                                            for d in site.domains: Rectangle {
                                                height: 26px;
                                                background: domain-touch.has-hover ? #F1F3F5 : transparent;
                                                animate background { duration: 100ms; }

                                                HorizontalLayout {
                                                    // aligned under the site name column
                                                    padding-left: 76px;
                                                    padding-right: 14px;
                                                    spacing: 10px;

                                                    Text {
                                                        text: d.host;
                                                        horizontal-stretch: 1;
                                                        font-size: 11.5px;
                                                        font-family: "Menlo";
                                                        color: #3B434C;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }

                                                    Text {
                                                        text: d.status;
                                                        width: 42px;
                                                        font-size: 11.5px;
                                                        color: d.status-color;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: d.latency;
                                                        width: 54px;
                                                        font-size: 11.5px;
                                                        font-family: "Menlo";
                                                        color: #6B7480;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                domain-touch := TouchArea { }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 6px; }
                }
            }
        }

        if root.show-onboarding: VerticalLayout {
            padding: 24px;
            alignment: center;

            Rectangle {
                background: #FFFFFF;
                border-radius: 8px;
                border-width: 1px;
                border-color: #E1E4E8;

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    Text {
                        text: "环境检查未通过";
                        font-size: 17px;
                        font-weight: 600;
                        color: #1B1F24;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "加速前需要修复以下问题，修复后即可正常加速。";
                        font-size: 12.5px;
                        color: #5C6670;
                        horizontal-alignment: center;
                    }

                    Rectangle { height: 1px; background: #ECEEF0; }

                    // -- certificate trust --
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 6px;
                            background: root.ca-installed ? #E8F4EC : #EDF3FA;
                            Text {
                                text: root.ca-installed ? "✓" : "!";
                                font-size: 14px;
                                font-weight: 600;
                                color: root.ca-installed ? #1B7F4D : #0067C0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: root.ca-installed ? "证书已安装并受信任" : "本地证书未受信任";
                                font-size: 13px;
                                color: #1B1F24;
                            }
                            Text {
                                text: root.ca-installed ? "加速站点可以建立可信连接" : (root.ca-error != "" ? root.ca-error : "ECH / 伪造 SNI 加速依赖本地证书的信任");
                                font-size: 11.5px;
                                color: root.ca-installed ? #6B7480 : #C0392B;
                                wrap: word-wrap;
                            }
                        }
                        Rectangle {
                            width: 96px;
                            height: 30px;
                            if !root.ca-installed: ActionButton {
                                width: parent.width;
                                y: (parent.height - self.height) / 2;
                                label: root.ob-installing ? "等待确认…" : "安装证书";
                                clicked => {
                                    root.ob-installing = true;
                                    root.settings-action(1);
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #ECEEF0; }

                    // -- system proxy --
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 6px;
                            background: root.proxy-ok ? #E8F4EC : #EDF3FA;
                            Text {
                                text: root.proxy-ok ? "✓" : "!";
                                font-size: 14px;
                                font-weight: 600;
                                color: root.proxy-ok ? #1B7F4D : #0067C0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: root.proxy-ok ? "系统代理已生效" : "系统代理未生效";
                                font-size: 13px;
                                color: #1B1F24;
                            }
                            Text {
                                text: root.proxy-ok ? "浏览器流量会经过 hakimi" : "点击修复后自动重新应用 PAC 设置";
                                font-size: 11.5px;
                                color: root.proxy-ok ? #6B7480 : #C0392B;
                            }
                        }
                        Rectangle {
                            width: 96px;
                            height: 30px;
                            if !root.proxy-ok: ActionButton {
                                width: parent.width;
                                y: (parent.height - self.height) / 2;
                                label: "重新应用";
                                clicked => { root.reapply-proxy(); }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #ECEEF0; }

                    if root.ca-installed && root.proxy-ok: VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: "✓ 环境检查已通过";
                            font-size: 13.5px;
                            color: #1B7F4D;
                            horizontal-alignment: center;
                        }
                        ActionButton {
                            width: 200px;
                            label: "返回加速";
                            clicked => { root.finish-onboarding(); }
                        }
                    }

                    TextButton {
                        label: "暂不处理，返回主页";
                        clicked => { root.finish-onboarding(); }
                    }
                }
            }
        }

        if !root.show-onboarding && root.page == 1: VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 16px;
            padding-top: 16px;

            ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                    spacing: 0px;
                    alignment: start;

                    Rectangle {
                        border-radius: 8px;
                        background: #FFFFFF;
                        border-width: 1px;
                        border-color: #E1E4E8;
                        clip: true;

                        VerticalLayout {
                            spacing: 0px;

                            for entry in root.settings: Rectangle {
                                background: settings-touch.has-hover ? #F4F6F8 : #FFFFFF;
                                animate background { duration: 100ms; }

                                settings-touch := TouchArea {
                                    clicked => { }
                                }

                                VerticalLayout {
                                    spacing: 0px;

                                    if !entry.first: Rectangle {
                                        height: 1px;
                                        background: transparent;

                                        Rectangle {
                                            x: 59px;
                                            width: parent.width - 59px;
                                            height: parent.height;
                                            background: #ECEEF0;
                                        }
                                    }

                                    HorizontalLayout {
                                        height: 58px;
                                        padding: 11px;
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 12px;

                                        Rectangle {
                                            width: 30px;
                                            height: parent.height;
                                            border-radius: 6px;
                                            background: #EDF3FA;

                                            Rectangle {
                                                width: 15px;
                                                height: 15px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;

                                                if entry.icon-kind == 0: Path {
                                                    commands: "M 15 8.5 A 6 6 0 1 0 3 8.5 A 6 6 0 1 0 15 8.5 M 3 8.5 L 15 8.5 M 9 2.5 C 6.5 5 6.5 12 9 14.5 M 9 2.5 C 11.5 5 11.5 12 9 14.5";
                                                    stroke: #0067C0;
                                                    stroke-width: 1.2px;
                                                }
                                                if entry.icon-kind == 1: Rectangle {
                                                    y: 7px;
                                                    width: 11px;
                                                    height: 9px;
                                                    border-radius: 2px;
                                                    border-width: 1.2px;
                                                    border-color: #0067C0;
                                                }
                                                if entry.icon-kind == 1: Path {
                                                    commands: "M 5.5 8 L 5.5 5.5 A 3 3 0 0 1 11.5 5.5 L 11.5 8";
                                                    stroke: #0067C0;
                                                    stroke-width: 1.2px;
                                                }
                                                if entry.icon-kind == 2: Rectangle {
                                                    x: 0;
                                                    y: 2px;
                                                    width: 7px;
                                                    height: 13px;
                                                    border-radius: 2px;
                                                    border-width: 1.2px;
                                                    border-color: #0067C0;
                                                }
                                                if entry.icon-kind == 2: Rectangle {
                                                    x: 9px;
                                                    y: 2px;
                                                    width: 7px;
                                                    height: 13px;
                                                    border-radius: 2px;
                                                    border-width: 1.2px;
                                                    border-color: rgba(0, 103, 192, 0.45);
                                                }
                                                if entry.icon-kind == 3: Path {
                                                    commands: "M 2 4.5 A 7 2.4 0 1 0 16 4.5 A 7 2.4 0 1 0 2 4.5 M 2 4.5 L 2 12.5 C 2 13.9 4.7 15 9 15 C 13.3 15 16 13.9 16 12.5 L 16 4.5 M 2 8.5 C 2 9.9 4.7 11 9 11 C 13.3 11 16 9.9 16 8.5";
                                                    stroke: #0067C0;
                                                    stroke-width: 1.1px;
                                                }
                                                if entry.icon-kind == 4: Path {
                                                    commands: "M 15.5 9 A 6.5 6.5 0 1 0 2.5 9 A 6.5 6.5 0 1 0 15.5 9 M 9 8.2 L 9 12.4 M 9 5.4 L 9 5.6";
                                                    stroke: #0067C0;
                                                    stroke-width: 1.4px;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: entry.title;
                                                font-size: 13px;
                                                color: #1B1F24;
                                            }
                                            Text {
                                                text: entry.subtitle;
                                                font-size: 11.5px;
                                                color: #6B7480;
                                                overflow: elide;
                                            }
                                        }

                                        if entry.action-label != "": Rectangle {
                                            width: 74px;
                                            height: parent.height;

                                            Rectangle {
                                                width: 66px;
                                                height: 27px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 5px;
                                                background: entry.action-tone == 1
                                                    ? (button-touch.has-hover ? #F9ECEB : #FFFFFF)
                                                    : (button-touch.has-hover ? #EDF3FA : #FFFFFF);
                                                border-width: 1px;
                                                border-color: entry.action-tone == 1
                                                    ? #E4C7C5
                                                    : #C5D9EC;
                                                animate background { duration: 100ms; }

                                                Text {
                                                    text: entry.action-label;
                                                    font-size: 12px;
                                                    color: entry.action-tone == 1 ? #C0392B : #0067C0;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                button-touch := TouchArea {
                                                    clicked => { root.settings-action(entry.action-kind); }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            width: 10px;
                                            height: parent.height;
                                            Path {
                                                width: 10px;
                                                height: 10px;
                                                y: (parent.height - self.height) / 2;
                                                commands: "M 3.8 2.2 L 7.8 5.8 L 3.8 9.4";
                                                stroke: #98A1AB;
                                                stroke-width: 1.4px;
                                                stroke-line-cap: round;
                                                stroke-line-join: round;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 6px; }
                }
            }
        }
    }
}
