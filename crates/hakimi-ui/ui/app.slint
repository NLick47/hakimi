import { ScrollView } from "std-widgets.slint";

export struct DomainEntry {
    host: string,
    status: string,
    status-color: color,
    latency: string,
}

export struct SiteEntry {
    id: string,
    name: string,
    icon: image,
    initial: string,
    tile-color: color,
    summary: string,
    enabled: bool,
    open: bool,
    first: bool,
    last: bool,
    url: string,
    domains: [DomainEntry],
}

export struct SettingsEntry {
    title: string,
    subtitle: string,
    icon-kind: int,
    action-label: string,
    action-kind: int,
    action-tone: int,
    last: bool,
}

// -- controls ----------------------------------------------------------------

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> emphasis: true;
    callback clicked();

    height: 34px;
    min-width: 96px;
    border-radius: 9px;
    border-width: emphasis ? 0px : 1px;
    border-color: emphasis ? transparent : rgba(192, 70, 63, 0.32);
    background: emphasis
        ? (touch.pressed ? #10589F : touch.has-hover ? #146EC8 : #1877D2)
        : (touch.pressed ? rgba(192, 70, 63, 0.09) : touch.has-hover ? rgba(192, 70, 63, 0.05) : rgba(255, 255, 255, 0.9));
    animate background { duration: 140ms; easing: ease-out; }

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 500;
        color: emphasis ? #FFFFFF : #C0463F;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PowerBadge inherits Rectangle {
    in property <bool> active;

    width: 42px;
    height: 42px;
    border-radius: 21px;
    background: active ? #1877D2 : rgba(120, 134, 150, 0.12);
    animate background { duration: 240ms; easing: ease-out; }

    // soft halo makes the running state read as "lit"
    Rectangle {
        width: parent.width + 6px;
        height: parent.height + 6px;
        x: -3px;
        y: -3px;
        border-radius: parent.border-radius + 3px;
        border-width: 1px;
        border-color: rgba(24, 119, 210, 0.28);
        opacity: root.active ? 1 : 0;
        animate opacity { duration: 240ms; }
    }

    // inner highlight keeps the badge from reading flat
    Rectangle {
        width: parent.width - 2px;
        height: parent.height - 2px;
        x: 1px;
        y: 1px;
        border-radius: parent.border-radius - 1px;
        border-width: 1px;
        border-color: active ? rgba(255, 255, 255, 0.24) : rgba(255, 255, 255, 0.6);
    }

    Path {
        width: 19px;
        height: 19px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 14.6 5.3 A 6.8 6.8 0 1 1 4.4 5.3 M 9.5 1.6 L 9.5 9.5";
        stroke: active ? #FFFFFF : #7A8794;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        animate stroke { duration: 240ms; }
    }
}

component BackIcon inherits Rectangle {
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: touch.has-hover ? rgba(24, 119, 210, 0.10) : transparent;
    animate background { duration: 140ms; }

    Path {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 10 3 L 4.5 8 L 10 13";
        stroke: #1877D2;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component CheckSquare inherits Rectangle {
    in property <bool> checked;
    callback toggled();

    width: 18px;
    height: 18px;
    border-radius: 5px;
    border-width: 1.3px;
    border-color: checked || touch.has-hover ? #1877D2 : #A8B2BE;
    background: checked ? #1877D2 : #FFFFFF;
    animate background { duration: 140ms; easing: ease-out; }
    animate border-color { duration: 140ms; }

    Path {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 1 5.4 L 4 8.2 L 9 2.4";
        stroke: #FFFFFF;
        stroke-width: 1.9px;
        stroke-line-cap: round;
        stroke-line-join: round;
        opacity: checked ? 1 : 0;
        animate opacity { duration: 140ms; }
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

component Chevron inherits Rectangle {
    in property <bool> open;
    width: 12px;
    height: 12px;

    Path {
        width: 12px;
        height: 12px;
        commands: "M 4.5 2.5 L 9 7 L 4.5 11.5";
        stroke: root.open ? #5C6672 : #AEB7C2;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        opacity: root.open ? 0 : 1;
        animate opacity { duration: 150ms; }
    }
    Path {
        width: 12px;
        height: 12px;
        commands: "M 2.5 5 L 6 8.5 L 9.5 5";
        stroke: #5C6672;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: 150ms; }
    }
}

component GearIcon inherits Rectangle {
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: touch.has-hover ? rgba(255, 255, 255, 0.9) : transparent;
    animate background { duration: 140ms; }

    Path {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 14 9 A 5 5 0 1 0 4 9 A 5 5 0 1 0 14 9 M 11 9 A 2 2 0 1 0 7 9 A 2 2 0 1 0 11 9";
        stroke: touch.has-hover ? #1877D2 : #5C6672;
        stroke-width: 1.5px;
        animate stroke { duration: 140ms; }
    }
    Path {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 14 9 L 15.6 9 M 12.54 12.54 L 13.7 13.7 M 9 14 L 9 15.6 M 5.46 12.54 L 4.3 13.7 M 4 9 L 2.4 9 M 5.46 5.46 L 4.3 4.3 M 9 4 L 9 2.4 M 12.54 5.46 L 13.7 4.3";
        stroke: touch.has-hover ? #1877D2 : #5C6672;
        stroke-width: 2.2px;
        stroke-line-cap: round;
        animate stroke { duration: 140ms; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TextButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 24px;
    min-width: 40px;
    border-radius: 6px;
    background: touch.has-hover ? rgba(24, 119, 210, 0.08) : transparent;
    animate background { duration: 140ms; }

    Text {
        text: root.label;
        font-size: 12px;
        color: touch.has-hover ? #1877D2 : #6B7684;
        animate color { duration: 140ms; }
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// -- app window --------------------------------------------------------------

export component AppWindow inherits Window {
    title: "hakimi";
    width: 540px;
    height: 640px;
    background: #DDE6F0;

    in property <[SiteEntry]> sites;
    in property <[SettingsEntry]> settings;
    in property <string> status-subtitle: "正在启动";
    in property <bool> running: false;
    in-out property <int> page: 0;

    callback toggle-master();
    callback toggle-group(string, bool);
    callback select-all(bool);
    callback probe-all();
    callback open-site(string);
    callback toggle-open(string);
    callback settings-action(int);

    VerticalLayout {
        spacing: 0px;

        // ---- top bar ----
        Rectangle {
            height: 44px;
            background: rgba(255, 255, 255, 0.40);

            // light from the top edge
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: @linear-gradient(180deg, rgba(255, 255, 255, 0.50), rgba(255, 255, 255, 0));
            }

            // hairline separating the bar from the content
            Rectangle {
                width: parent.width;
                height: 1px;
                y: parent.height - 1px;
                background: rgba(110, 132, 156, 0.18);
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 10px;
                spacing: 10px;

                Rectangle {
                    width: 30px;
                    height: parent.height;

                    if root.page == 0: Rectangle {
                        width: 23px;
                        height: 23px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 7px;
                        background: #1877D2;

                        Path {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            commands: "M 7.2 0.6 L 2 6.8 L 5.4 6.8 L 4.5 11.4 L 9.9 4.6 L 6.3 4.6 Z";
                            fill: #FFFFFF;
                        }
                    }

                    if root.page == 1: BackIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.page = 0; }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    if root.page == 1: Text {
                        text: "设置";
                        font-size: 14px;
                        font-weight: 500;
                        color: #26303C;
                    }
                }

                Rectangle {
                    width: 34px;
                    height: parent.height;

                    if root.page == 0: GearIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.page = 1; }
                    }
                }
            }
        }

        if root.page == 0: VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 0px;

            // ---- status card ----
            Rectangle {
                height: 86px;
                background: root.running ? rgba(24, 119, 210, 0.07) : rgba(255, 255, 255, 0.84);
                border-radius: 14px;
                border-width: 0.5px;
                border-color: root.running ? rgba(24, 119, 210, 0.26) : rgba(130, 150, 172, 0.18);
                animate background { duration: 260ms; easing: ease-out; }
                animate border-color { duration: 260ms; }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 13px;

                    Rectangle {
                        width: 42px;
                        height: parent.height;
                        PowerBadge {
                            y: (parent.height - self.height) / 2;
                            active: root.running;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: root.running ? "加速已开启" : "加速已暂停";
                            font-size: 15.5px;
                            font-weight: 500;
                            color: #1F2733;
                        }
                        Text {
                            text: root.status-subtitle;
                            font-size: 12px;
                            color: #7A8794;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 100px;
                        height: parent.height;
                        ActionButton {
                            width: parent.width;
                            y: (parent.height - self.height) / 2;
                            label: root.running ? "停止加速" : "开启加速";
                            emphasis: !root.running;
                            clicked => { root.toggle-master(); }
                        }
                    }
                }
            }

            // ---- section header ----
            Rectangle {
                height: 42px;

                HorizontalLayout {
                    padding-left: 2px;
                    padding-right: 2px;
                    padding-top: 14px;
                    padding-bottom: 4px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "站点";
                            font-size: 12.5px;
                            font-weight: 500;
                            color: #6B7684;
                        }
                    }

                    HorizontalLayout {
                        spacing: 2px;
                        TextButton { label: "测速"; min-width: 42px; clicked => { root.probe-all(); } }
                        TextButton { label: "全选"; min-width: 42px; clicked => { root.select-all(true); } }
                        TextButton { label: "清除"; min-width: 42px; clicked => { root.select-all(false); } }
                    }
                }
            }

            // ---- grouped site list ----
            site-scroll := ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                    spacing: 0px;
                    alignment: start;

                    Rectangle {
                        border-radius: 14px;
                        background: rgba(255, 255, 255, 0.88);
                        border-width: 0.5px;
                        border-color: rgba(130, 150, 172, 0.18);
                        clip: true;

                        VerticalLayout {
                            spacing: 0px;

                            for site in root.sites: Rectangle {
                                background: site.open ? rgba(24, 119, 210, 0.035)
                                    : (row-touch.has-hover ? rgba(24, 119, 210, 0.045) : transparent);
                                animate background { duration: 150ms; }

                                VerticalLayout {
                                    spacing: 0px;

                                    // row
                                    Rectangle {
                                        height: 54px;

                                        // below the layout so the checkbox and the
                                        // 访问 button keep their own clicks
                                        row-touch := TouchArea {
                                            clicked => { root.toggle-open(site.id); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 12px;
                                            spacing: 11px;

                                            Rectangle {
                                                width: 18px;
                                                height: parent.height;
                                                CheckSquare {
                                                    y: (parent.height - self.height) / 2;
                                                    checked: site.enabled;
                                                    toggled => { root.toggle-group(site.id, !site.enabled); }
                                                }
                                            }

                                            Rectangle {
                                                width: 30px;
                                                height: parent.height;

                                                Rectangle {
                                                    width: 30px;
                                                    height: 30px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 9px;
                                                    background: site.icon.width > 0 ? rgba(255, 255, 255, 0.98) : site.tile-color;
                                                    border-width: 0.5px;
                                                    border-color: site.icon.width > 0 ? rgba(130, 150, 172, 0.22) : transparent;
                                                    clip: true;

                                                    if site.icon.width > 0: Image {
                                                        width: 19px;
                                                        height: 19px;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        source: site.icon;
                                                    }
                                                    if site.icon.width == 0: Text {
                                                        text: site.initial;
                                                        font-size: 13px;
                                                        font-weight: 500;
                                                        color: #FFFFFF;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;

                                                Text {
                                                    text: site.name;
                                                    font-size: 13.5px;
                                                    font-weight: 500;
                                                    color: #1F2733;
                                                }
                                                Text {
                                                    text: site.summary;
                                                    font-size: 11.5px;
                                                    color: #7C8794;
                                                    overflow: elide;
                                                }
                                            }

                                            Rectangle {
                                                width: 42px;
                                                height: parent.height;
                                                TextButton {
                                                    width: parent.width;
                                                    y: (parent.height - self.height) / 2;
                                                    label: "访问";
                                                    clicked => { root.open-site(site.url); }
                                                }
                                            }

                                            Rectangle {
                                                width: 12px;
                                                height: parent.height;
                                                Chevron {
                                                    y: (parent.height - self.height) / 2;
                                                    open: site.open;
                                                }
                                            }
                                        }
                                    }

                                    // expanded domains
                                    if site.open: Rectangle {
                                        height: site.domains.length * 28px + 1px;
                                        background: rgba(130, 150, 172, 0.05);

                                        VerticalLayout {
                                            spacing: 0px;

                                            Rectangle { height: 1px; background: rgba(24, 119, 210, 0.14); }

                                            for d in site.domains: Rectangle {
                                                height: 28px;
                                                background: domain-touch.has-hover ? rgba(24, 119, 210, 0.05) : transparent;
                                                animate background { duration: 140ms; }

                                                HorizontalLayout {
                                                    // aligned under the site name column
                                                    padding-left: 84px;
                                                    padding-right: 16px;
                                                    spacing: 10px;

                                                    Text {
                                                        text: d.host;
                                                        horizontal-stretch: 1;
                                                        font-size: 11.5px;
                                                        font-family: "Menlo";
                                                        color: #4A5560;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }

                                                    Text {
                                                        text: d.status;
                                                        width: 42px;
                                                        font-size: 11.5px;
                                                        color: d.status-color;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: d.latency;
                                                        width: 56px;
                                                        font-size: 11.5px;
                                                        font-family: "Menlo";
                                                        color: #7A8794;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                domain-touch := TouchArea { }
                                            }
                                        }
                                    }
                                }

                                // hairline between rows, inset to the text column
                                if !site.last: Rectangle {
                                    height: 1px;
                                    background: transparent;

                                    Rectangle {
                                        x: 84px;
                                        width: parent.width - 84px;
                                        height: parent.height;
                                        background: rgba(110, 132, 156, 0.22);
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 6px; }
                }
            }
        }

        if root.page == 1: VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 16px;
            padding-top: 14px;

            ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                    spacing: 0px;
                    alignment: start;

                    Rectangle {
                        height: root.settings.length * 60px;
                        border-radius: 14px;
                        background: rgba(255, 255, 255, 0.88);
                        border-width: 0.5px;
                        border-color: rgba(130, 150, 172, 0.18);
                        clip: true;

                        VerticalLayout {
                            spacing: 0px;

                            for entry in root.settings: Rectangle {
                                height: 60px;
                                background: settings-touch.has-hover ? rgba(24, 119, 210, 0.045) : transparent;
                                animate background { duration: 150ms; }

                                settings-touch := TouchArea {
                                    clicked => { }
                                }

                                HorizontalLayout {
                                    padding: 11px;
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 13px;

                                    Rectangle {
                                        width: 32px;
                                        height: parent.height;
                                        border-radius: 9px;
                                        background: rgba(24, 119, 210, 0.10);

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;

                                            if entry.icon-kind == 0: Path {
                                                commands: "M 15 8.5 A 6 6 0 1 0 3 8.5 A 6 6 0 1 0 15 8.5 M 3 8.5 L 15 8.5 M 9 2.5 C 6.5 5 6.5 12 9 14.5 M 9 2.5 C 11.5 5 11.5 12 9 14.5";
                                                stroke: #1877D2;
                                                stroke-width: 1.2px;
                                            }
                                            if entry.icon-kind == 1: Rectangle {
                                                y: 7px;
                                                width: 11px;
                                                height: 9px;
                                                border-radius: 2px;
                                                border-width: 1.3px;
                                                border-color: #1877D2;
                                            }
                                            if entry.icon-kind == 1: Path {
                                                commands: "M 5.5 8 L 5.5 5.5 A 3 3 0 0 1 11.5 5.5 L 11.5 8";
                                                stroke: #1877D2;
                                                stroke-width: 1.3px;
                                            }
                                            if entry.icon-kind == 2: Rectangle {
                                                x: 0;
                                                y: 2px;
                                                width: 7px;
                                                height: 13px;
                                                border-radius: 2px;
                                                border-width: 1.3px;
                                                border-color: #1877D2;
                                            }
                                            if entry.icon-kind == 2: Rectangle {
                                                x: 9px;
                                                y: 2px;
                                                width: 7px;
                                                height: 13px;
                                                border-radius: 2px;
                                                border-width: 1.3px;
                                                border-color: rgba(24, 119, 210, 0.45);
                                            }
                                            if entry.icon-kind == 3: Path {
                                                commands: "M 2 4.5 A 7 2.4 0 1 0 16 4.5 A 7 2.4 0 1 0 2 4.5 M 2 4.5 L 2 12.5 C 2 13.9 4.7 15 9 15 C 13.3 15 16 13.9 16 12.5 L 16 4.5 M 2 8.5 C 2 9.9 4.7 11 9 11 C 13.3 11 16 9.9 16 8.5";
                                                stroke: #1877D2;
                                                stroke-width: 1.1px;
                                            }
                                            if entry.icon-kind == 4: Path {
                                                commands: "M 15.5 9 A 6.5 6.5 0 1 0 2.5 9 A 6.5 6.5 0 1 0 15.5 9 M 9 8.2 L 9 12.4 M 9 5.4 L 9 5.6";
                                                stroke: #1877D2;
                                                stroke-width: 1.4px;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: entry.title;
                                            font-size: 13.5px;
                                            font-weight: 500;
                                            color: #1F2733;
                                        }
                                        Text {
                                            text: entry.subtitle;
                                            font-size: 11.5px;
                                            color: #8A95A2;
                                            overflow: elide;
                                        }
                                    }

                                    if entry.action-label != "": Rectangle {
                                        width: 78px;
                                        height: parent.height;

                                        Rectangle {
                                            width: 70px;
                                            height: 28px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 7px;
                                            background: entry.action-tone == 1
                                                ? (button-touch.has-hover ? rgba(192, 70, 63, 0.12) : rgba(192, 70, 63, 0.06))
                                                : (button-touch.has-hover ? rgba(24, 119, 210, 0.14) : rgba(24, 119, 210, 0.08));
                                            border-width: 0.5px;
                                            border-color: entry.action-tone == 1
                                                ? rgba(192, 70, 63, 0.30)
                                                : rgba(24, 119, 210, 0.30);
                                            animate background { duration: 140ms; }

                                            Text {
                                                text: entry.action-label;
                                                font-size: 12px;
                                                font-weight: 500;
                                                color: entry.action-tone == 1 ? #C0463F : #1877D2;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            button-touch := TouchArea {
                                                clicked => { root.settings-action(entry.action-kind); }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 12px;
                                        height: parent.height;
                                        Path {
                                            width: 12px;
                                            height: 12px;
                                            y: (parent.height - self.height) / 2;
                                            commands: "M 4.5 2.5 L 9 7 L 4.5 11.5";
                                            stroke: #AEB7C2;
                                            stroke-width: 1.5px;
                                            stroke-line-cap: round;
                                            stroke-line-join: round;
                                        }
                                    }
                                }

                                // hairline between rows, inset to the text column
                                if !entry.last: Rectangle {
                                    height: 1px;
                                    y: parent.height - 1px;
                                    background: transparent;

                                    Rectangle {
                                        x: 61px;
                                        width: parent.width - 61px - 16px;
                                        height: parent.height;
                                        background: rgba(110, 132, 156, 0.22);
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 6px; }
                }
            }
        }
    }
}
