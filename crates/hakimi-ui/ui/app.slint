import { ScrollView } from "std-widgets.slint";

export struct DomainEntry {
    host: string,
    status: string,
    status-color: color,
    latency: string,
}

export struct SiteEntry {
    id: string,
    name: string,
    icon: image,
    initial: string,
    tile-color: color,
    summary: string,
    enabled: bool,
    open: bool,
    url: string,
    domains: [DomainEntry],
}

export struct SettingsEntry {
    title: string,
    subtitle: string,
    icon-kind: int,
}

// -- custom controls ---------------------------------------------------------

component AppSwitch inherits Rectangle {
    in property <bool> checked;
    callback toggled();

    width: 40px;
    height: 21px;
    border-radius: 11px;
    background: checked ? #1877D2 : rgba(100, 115, 130, 0.3);
    animate background { duration: 160ms; }

    Rectangle {
        width: 13px;
        height: 13px;
        border-radius: 7px;
        background: #FCFCFD;
        y: (parent.height - self.height) / 2;
        x: checked ? parent.width - self.width - 4px : 4px;
        animate x { duration: 160ms; easing: ease-out; }
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

component CheckSquare inherits Rectangle {
    in property <bool> checked;
    callback toggled();

    width: 18px;
    height: 18px;
    border-radius: 5px;
    border-width: 1.3px;
    border-color: checked || touch.has-hover ? #1877D2 : #98A4B0;
    background: checked ? #1877D2 : #FFFFFF;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    Path {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 1 5.4 L 4 8.2 L 9 2.4";
        stroke: #FFFFFF;
        stroke-width: 1.8px;
        opacity: checked ? 1 : 0;
        animate opacity { duration: 130ms; }
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

component Chevron inherits Rectangle {
    in property <bool> open;
    width: 12px;
    height: 12px;

    if !open: Path {
        width: 12px;
        height: 12px;
        commands: "M 4 2.5 L 8.5 7 L 4 11.5";
        stroke: #9AA5B1;
        stroke-width: 1.5px;
        opacity: 1;
        animate opacity { duration: 120ms; }
    }
    if open: Path {
        width: 12px;
        height: 12px;
        commands: "M 2.5 4 L 7 8.5 L 11.5 4";
        stroke: #7A8794;
        stroke-width: 1.5px;
        opacity: 1;
        animate opacity { duration: 120ms; }
    }
}

component GearIcon inherits Rectangle {
    callback clicked();
    in property <bool> hovered-out;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: touch.has-hover ? rgba(24, 119, 210, 0.09) : transparent;
    animate background { duration: 120ms; }

    Path {
        width: 19px;
        height: 19px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 12.6 9.5 A 2.6 2.6 0 1 0 7.4 9.5 A 2.6 2.6 0 1 0 12.6 9.5 M 9.5 2.5 L 9.5 4.7 M 9.5 14.3 L 9.5 16.5 M 2.5 9.5 L 4.7 9.5 M 14.3 9.5 L 16.5 9.5 M 4.7 4.7 L 6.3 6.3 M 12.7 12.7 L 14.3 14.3 M 14.3 4.7 L 12.7 6.3 M 6.3 12.7 L 4.7 14.3";
        stroke: touch.has-hover ? #1877D2 : #7A8794;
        stroke-width: 1.4px;
        animate stroke { duration: 120ms; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component TextButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 22px;
    min-width: 30px;
    border-radius: 5px;
    background: touch.has-hover ? rgba(24, 119, 210, 0.07) : transparent;
    animate background { duration: 120ms; }

    Text {
        text: root.label;
        font-size: 12.5px;
        color: touch.has-hover ? #1877D2 : #6B7684;
        animate color { duration: 120ms; }
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SettingsRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <int> icon-kind;
    height: 56px;
    border-radius: 10px;
    background: touch.has-hover ? rgba(255, 255, 255, 0.92) : rgba(255, 255, 255, 0.6);
    border-width: 0.5px;
    border-color: rgba(140, 160, 180, 0.28);
    animate background { duration: 130ms; }

    HorizontalLayout {
        padding: 11px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 13px;

        Rectangle {
            width: 34px;
            border-radius: 9px;
            background: rgba(24, 119, 210, 0.1);

            Rectangle {
                width: 17px;
                height: 17px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                if root.icon-kind == 0: Path {
                    commands: "M 15 8.5 A 6 6 0 1 0 3 8.5 A 6 6 0 1 0 15 8.5 M 3 8.5 L 15 8.5 M 9 2.5 C 6.5 5 6.5 12 9 14.5 M 9 2.5 C 11.5 5 11.5 12 9 14.5";
                    stroke: #1877D2;
                    stroke-width: 1.2px;
                }
                if root.icon-kind == 1: Rectangle {
                    y: 7px;
                    width: 11px;
                    height: 9px;
                    border-radius: 2px;
                    border-width: 1.3px;
                    border-color: #1877D2;
                }
                if root.icon-kind == 1: Path {
                    commands: "M 5.5 8 L 5.5 5.5 A 3 3 0 0 1 11.5 5.5 L 11.5 8";
                    stroke: #1877D2;
                    stroke-width: 1.3px;
                }
                if root.icon-kind == 2: Rectangle {
                    x: 0;
                    y: 2px;
                    width: 7px;
                    height: 13px;
                    border-radius: 2px;
                    border-width: 1.3px;
                    border-color: #1877D2;
                }
                if root.icon-kind == 2: Rectangle {
                    x: 9px;
                    y: 2px;
                    width: 7px;
                    height: 13px;
                    border-radius: 2px;
                    border-width: 1.3px;
                    border-color: rgba(24, 119, 210, 0.45);
                }
                if root.icon-kind == 3: Path {
                    commands: "M 2 4.5 A 7 2.4 0 1 0 16 4.5 A 7 2.4 0 1 0 2 4.5 M 2 4.5 L 2 12.5 C 2 13.9 4.7 15 9 15 C 13.3 15 16 13.9 16 12.5 L 16 4.5 M 2 8.5 C 2 9.9 4.7 11 9 11 C 13.3 11 16 9.9 16 8.5";
                    stroke: #1877D2;
                    stroke-width: 1.1px;
                }
                if root.icon-kind == 4: Path {
                    commands: "M 15.5 9 A 6.5 6.5 0 1 0 2.5 9 A 6.5 6.5 0 1 0 15.5 9 M 9 8.2 L 9 12.4 M 9 5.4 L 9 5.6";
                    stroke: #1877D2;
                    stroke-width: 1.4px;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: root.title;
                font-size: 13.5px;
                color: #1A1A1A;
            }
            Text {
                text: root.subtitle;
                font-size: 11.5px;
                color: #8A95A2;
            }
        }

        Rectangle {
            width: 12px;
            Chevron { open: false; }
        }
    }

    touch := TouchArea {
        clicked => { }
    }
}

// -- app window --------------------------------------------------------------

export component AppWindow inherits Window {
    title: "hakimi";
    width: 540px;
    height: 600px;
    background: @linear-gradient(165deg, #D7E3EE 0%, #DCE6F0 100%);

    in property <[SiteEntry]> sites;
    in property <[SettingsEntry]> settings;
    in property <string> status-subtitle: "正在启动";
    in property <bool> running: false;
    in-out property <int> page: 0;

    callback toggle-master();
    callback toggle-group(string, bool);
    callback select-all(bool);
    callback probe-all();
    callback open-site(string);
    callback toggle-open(string);

    VerticalLayout {

        // header
        Rectangle {
            height: 48px;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 4px;
                spacing: 9px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 9px;
                    alignment: start;

                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 7px;
                        background: #1877D2;

                        Path {
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            commands: "M 2 7.5 L 9 1 L 9 5.5 L 12 5.5 L 12 9.5 L 9 9.5 L 9 14 Z";
                            fill: #FFFFFF;
                        }
                    }

                    Text {
                        text: "hakimi";
                        font-size: 14.5px;
                        font-weight: 500;
                        color: #1A1A1A;
                        vertical-alignment: center;
                    }
                }

                GearIcon {
                    clicked => { root.page = root.page == 0 ? 1 : 0; }
                }
            }
        }

        if root.page == 0: VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 14px;
            spacing: 0px;

            // master switch card
            Rectangle {
                height: 72px;
                background: rgba(255, 255, 255, 0.75);
                border-radius: 12px;
                border-width: 0.5px;
                border-color: rgba(140, 160, 180, 0.25);

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;

                        Text {
                            text: root.running ? "加速已开启" : "加速已关闭";
                            font-size: 15px;
                            font-weight: 500;
                            color: #1A1A1A;
                        }
                        Text {
                            text: root.status-subtitle;
                            font-size: 12px;
                            color: #7A8794;
                        }
                    }

                    AppSwitch {
                        checked: root.running;
                        toggled => { root.toggle-master(); }
                    }
                }
            }

            // section header
            Rectangle {
                height: 32px;

                HorizontalLayout {
                    padding-left: 2px;
                    padding-right: 2px;
                    padding-top: 8px;
                    padding-bottom: 2px;
                    spacing: 2px;
                    alignment: space-between;

                    Text {
                        text: "站点";
                        font-size: 13px;
                        font-weight: 500;
                        color: #4A5560;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 2px;
                        TextButton { label: "测速"; clicked => { root.probe-all(); } }
                        TextButton { label: "全选"; clicked => { root.select-all(true); } }
                        TextButton { label: "清除"; clicked => { root.select-all(false); } }
                    }
                }
            }

            // site list
            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 7px;
                    alignment: start;

                    for site in root.sites: Rectangle {
                        background: site.open ? #FFFFFF : rgba(255, 255, 255, 0.72);
                        border-radius: 10px;
                        border-width: 0.5px;
                        border-color: site.open ? rgba(24, 119, 210, 0.35) : rgba(140, 160, 180, 0.28);
                        clip: true;
                        animate background { duration: 140ms; }
                        animate border-color { duration: 140ms; }

                        TouchArea {
                            clicked => { root.toggle-open(site.id); }
                        }

                        VerticalLayout {
                            // header row
                            Rectangle {
                                height: 52px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    alignment: space-between;

                                    CheckSquare {
                                        checked: site.enabled;
                                        toggled => { root.toggle-group(site.id, !site.enabled); }
                                    }

                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 8px;
                                        background: site.icon.width > 0 ? #FFFFFF : site.tile-color;
                                        border-width: 0.5px;
                                        border-color: site.icon.width > 0 ? rgba(120, 140, 160, 0.25) : transparent;
                                        clip: true;

                                        if site.icon.width > 0: Image {
                                            width: 22px;
                                            height: 22px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: site.icon;
                                        }
                                        if site.icon.width == 0: Text {
                                            text: site.initial;
                                            font-size: 14px;
                                            font-weight: 500;
                                            color: #FFFFFF;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 1px;

                                        Text {
                                            text: site.name;
                                            font-size: 13.5px;
                                            color: #1A1A1A;
                                        }
                                        Text {
                                            text: site.summary;
                                            font-size: 11.5px;
                                            color: #8A95A2;
                                            overflow: elide;
                                        }
                                    }

                                    Rectangle {
                                        width: 40px;
                                        TextButton {
                                            label: "访问";
                                            clicked => { root.open-site(site.url); }
                                        }
                                    }

                                    Rectangle {
                                        width: 12px;
                                        Chevron { open: site.open; }
                                    }
                                }
                            }

                            // expanded domain list
                            if site.open: Rectangle {
                                height: site.domains.length * 27px + 1px;
                                background: transparent;

                                VerticalLayout {
                                    Rectangle { height: 1px; background: rgba(140, 160, 180, 0.18); }

                                    for d in site.domains: Rectangle {
                                        height: 27px;

                                        HorizontalLayout {
                                            padding-left: 62px;
                                            padding-right: 14px;
                                            spacing: 8px;
                                            alignment: space-between;

                                            Text {
                                                text: d.host;
                                                font-size: 12.5px;
                                                font-family: "Menlo";
                                                color: #525E6A;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: end;

                                                Text {
                                                    text: d.status;
                                                    font-size: 11.5px;
                                                    color: d.status-color;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: d.latency;
                                                    font-size: 11.5px;
                                                    font-family: "Menlo";
                                                    color: #7A8794;
                                                    width: 46px;
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 4px; }
                }
            }
        }

        if root.page == 1: VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 14px;

            // back + title
            Rectangle {
                height: 40px;

                HorizontalLayout {
                    padding: 6px;
                    spacing: 9px;
                    alignment: start;

                    Rectangle {
                        width: 22px;
                        Path {
                            width: 14px;
                            height: 14px;
                            y: 4px;
                            commands: "M 9 2 L 3.5 7.5 L 9 13";
                            stroke: #1877D2;
                            stroke-width: 1.8px;
                        }
                        TouchArea {
                            clicked => { root.page = 0; }
                        }
                    }

                    Text {
                        text: "高级设置";
                        font-size: 15px;
                        font-weight: 500;
                        color: #1A1A1A;
                        vertical-alignment: center;
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 7px;
                    alignment: start;

                    for entry in root.settings: SettingsRow {
                        title: entry.title;
                        subtitle: entry.subtitle;
                        icon-kind: entry.icon-kind;
                    }

                    Rectangle { height: 4px; }
                }
            }
        }
    }
}
