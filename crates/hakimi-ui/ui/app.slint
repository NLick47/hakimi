import { ScrollView } from "std-widgets.slint";

// Desktop-native palette: neutral window, solid surfaces, hairline borders.
// No gradients, no translucency, small radii.

export struct DomainEntry {
    host: string,
    status: string,
    status-color: color,
    latency: string,
}

export struct EditorDomain {
    pattern: string,
    route: int,
    route-label: string,
    sni: string,
    custom: string,
}

export struct SiteEntry {
    id: string,
    name: string,
    icon: image,
    initial: string,
    tile-color: color,
    summary: string,
    summary-color: color,
    enabled: bool,
    open: bool,
    first: bool,
    last: bool,
    url: string,
    custom: bool,
    domains: [DomainEntry],
}

// -- settings controls --------------------------------------------------------

component InlineField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> invalid: false;
    callback commit(string);
    property <bool> dirty: false;

    width: 252px;
    height: 30px;
    border-radius: 6px;
    background: #FFFFFF;
    border-width: 1px;
    border-color: input.has-focus ? #0067C0 : (root.invalid ? #C05B5B : #D8DDE3);
    animate border-color { duration: 120ms; }

    // Clicks on the inner padding should focus the editor too.
    TouchArea {
        clicked => { input.focus(); }
    }

    // Behind the editor: the caret must stay visible on an empty field.
    if root.text == "": Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height - 1px;
        text: root.placeholder;
        font-size: 12px;
        color: #A8B0B9;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height - 1px;
        text <=> root.text;
        single-line: true;
        font-size: 12.5px;
        color: #1B1F24;
        vertical-alignment: center;
        edited => { root.dirty = true; }
        accepted => {
            if root.dirty {
                root.dirty = false;
                root.commit(root.text);
            }
        }
    }

    out property <bool> focused: input.has-focus;
    changed focused => {
        if !self.focused && root.dirty {
            root.dirty = false;
            root.commit(root.text);
        }
    }
}

/// Light themed text input. The std-widgets LineEdit follows the OS theme and
/// rendered as a dark block on a light window; every editor field uses this
/// component instead so contrast and sizing stay predictable.
component FormInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> invalid: false;
    callback edited(string);

    height: 40px;
    border-radius: 8px;
    background: #FFFFFF;
    border-width: 1px;
    border-color: input.has-focus ? #0067C0 : (root.invalid ? #C05B5B : #D8DDE3);
    animate border-color { duration: 120ms; }

    if root.text == "": Text {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        text: root.placeholder;
        font-size: 13px;
        color: #98A1AB;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height - 1px;
        text <=> root.text;
        single-line: true;
        font-size: 14px;
        color: #1B1F24;
        vertical-alignment: center;
        edited => { root.edited(root.text); }
    }
}

/// Route dropdown trigger. Shows the current choice plus a chevron so the row
/// reads as a menu instead of a mysterious click-to-cycle label.
component RouteSelect inherits Rectangle {
    in property <string> label;
    in property <int> current: 0;
    in property <[string]> model;
    callback selected(int);

    width: 126px;
    height: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: popup.is-open ? #0067C0 : (touch.has-hover ? #BFC7CF : #D6DBE0);
    background: popup.is-open ? #F2F7FC : (touch.has-hover ? #F2F4F6 : #FFFFFF);
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 3px;

        Text {
            text: "线路";
            font-size: 11px;
            color: #98A1AB;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: 12.5px;
            color: #1B1F24;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Path {
                width: 10px;
                height: 10px;
                commands: popup.is-open ? "M 2.2 3.8 L 5.4 6.8 L 8.6 3.8" : "M 2.4 4 L 5 6.6 L 7.6 4";
                stroke: #5C6670;
                stroke-width: 1.4px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
    }

    touch := TouchArea {
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: root.width - 172px;
        y: root.height + 6px;
        width: 172px;
        height: root.model.length * 32px + 8px;
        close-policy: close-on-click-outside;

        Rectangle {
            border-radius: 8px;
            background: #FFFFFF;
            border-width: 1px;
            border-color: #D6DBE0;
            drop-shadow-blur: 18px;
            drop-shadow-color: rgba(15, 18, 22, 0.18);
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;

                for option[k] in root.model: Rectangle {
                    height: 32px;
                    border-radius: 5px;
                    background: k == root.current ? #EDF3FA : (option-touch.has-hover ? #F2F4F6 : transparent);
                    animate background { duration: 100ms; }

                    Text {
                        x: 10px;
                        width: parent.width - 36px;
                        text: option;
                        font-size: 12.5px;
                        color: k == root.current ? #0067C0 : #1B1F24;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if k == root.current: Path {
                        width: 10px;
                        height: 10px;
                        x: parent.width - 22px;
                        y: (parent.height - self.height) / 2;
                        commands: "M 1.5 5.2 L 4 7.6 L 8.6 2.4";
                        stroke: #0067C0;
                        stroke-width: 1.6px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                    }

                    option-touch := TouchArea {
                        clicked => {
                            root.selected(k);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

/// A settings row: fixed label column, divider with symmetric insets, and one
/// right-aligned control. Standalone on purpose — inheriting a base row made
/// the divider compute its width from the row's content instead of the card.
/// 1px separator between rows, inset 16px on both sides. The card owns the
/// separators: a row's own width is only known after the layout assigns it, and
/// reading it back inside the row returned the content width instead.
component RowLine inherits HorizontalLayout {
    height: 1px;

    Rectangle { width: 16px; height: 1px; }
    Rectangle { horizontal-stretch: 1; height: 1px; background: #ECEEF0; }
    Rectangle { width: 16px; height: 1px; }
}

component FieldRow inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <string> setting-key;
    in property <string> error-key;
    callback commit(string);

    height: root.hint == "" ? 52px : 58px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        VerticalLayout {
            width: 112px;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.label;
                font-size: 13px;
                color: #1B1F24;
            }
            if root.hint != "": Text {
                text: root.hint;
                font-size: 11px;
                color: #8A95A2;
                overflow: elide;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        VerticalLayout {
            alignment: center;

            InlineField {
                text <=> root.text;
                placeholder: root.placeholder;
                invalid: root.error-key != "" && root.error-key == root.setting-key;
                commit(value) => { root.commit(value); }
            }
        }
    }
}

export component AlreadyRunningWindow inherits Window {
    title: "hakimi";
    width: 340px;
    height: 120px;
    background: #FFFFFF;

    VerticalLayout {
        alignment: center;
        spacing: 6px;

        Text {
            text: "hakimi 已经在运行";
            font-size: 14px;
            font-weight: 600;
            color: #1B1F24;
            horizontal-alignment: center;
        }
        Text {
            text: "请使用已打开的窗口";
            font-size: 12px;
            color: #6B7480;
            horizontal-alignment: center;
        }
    }
}

// -- controls ----------------------------------------------------------------

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> emphasis: true;
    callback clicked();

    height: 32px;
    min-width: 92px;
    border-radius: 6px;
    border-width: emphasis ? 0px : 1px;
    border-color: emphasis ? transparent : #D6DBE0;
    background: emphasis
        ? (touch.pressed ? #005BA6 : touch.has-hover ? #0B72BE : #0067C0)
        : (touch.pressed ? #ECEEF0 : touch.has-hover ? #F2F4F6 : #FFFFFF);
    animate background { duration: 100ms; }

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 400;
        color: emphasis ? #FFFFFF : #C0392B;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PowerBadge inherits Rectangle {
    in property <bool> active;

    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: active ? #0067C0 : #E9ECEF;

    Path {
        width: 17px;
        height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 13.2 4.8 A 6.2 6.2 0 1 1 4.8 4.8 M 9 1.5 L 9 8.8";
        stroke: active ? #FFFFFF : #6B7680;
        stroke-width: 1.7px;
        stroke-line-cap: round;
    }
}

component BackIcon inherits Rectangle {
    callback clicked();

    width: 26px;
    height: 26px;
    border-radius: 5px;
    background: touch.has-hover ? #E9EBEE : transparent;
    animate background { duration: 100ms; }

    Path {
        width: 15px;
        height: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 9.5 3 L 4.5 7.5 L 9.5 12";
        stroke: #3B434C;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component CheckSquare inherits Rectangle {
    in property <bool> checked;
    callback toggled();

    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: 1px;
    border-color: checked || touch.has-hover ? #0067C0 : #9AA3AC;
    background: checked ? #0067C0 : #FFFFFF;
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    Path {
        width: 9px;
        height: 9px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 1 4.9 L 3.7 7.4 L 8 2.2";
        stroke: #FFFFFF;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
        opacity: checked ? 1 : 0;
        animate opacity { duration: 100ms; }
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

component Chevron inherits Rectangle {
    in property <bool> open;
    width: 10px;
    height: 10px;

    Path {
        width: 10px;
        height: 10px;
        commands: "M 3.8 2.2 L 7.8 5.8 L 3.8 9.4";
        stroke: root.open ? #5C6670 : #98A1AB;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        opacity: root.open ? 0 : 1;
        animate opacity { duration: 120ms; }
    }
    Path {
        width: 10px;
        height: 10px;
        commands: "M 2.2 3.8 L 5.4 6.8 L 8.6 3.8";
        stroke: #5C6670;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: 120ms; }
    }
}

component SettingsIcon inherits Rectangle {
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 5px;
    background: touch.has-hover ? #E9EBEE : transparent;
    animate background { duration: 100ms; }

    // Three rails with a knob each: reads as "settings" at 17px far better
    // than a toothed gear, which turns into a blob at this size.
    Path {
        width: 17px;
        height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: "M 0.5 4.2 L 8 4.2 M 13.6 4.2 L 16.5 4.2 M 0.5 8.5 L 3.6 8.5 M 8.8 8.5 L 16.5 8.5 M 0.5 12.8 L 8.2 12.8 M 13.8 12.8 L 16.5 12.8";
        stroke: touch.has-hover ? #3B434C : #5C6670;
        stroke-width: 1.3px;
        stroke-line-cap: round;
        animate stroke { duration: 100ms; }
    }
    Rectangle {
        x: 14.2px;
        y: 7.7px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: touch.has-hover ? #3B434C : #5C6670;
        animate background { duration: 100ms; }
    }
    Rectangle {
        x: 9.6px;
        y: 12px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: touch.has-hover ? #3B434C : #5C6670;
        animate background { duration: 100ms; }
    }
    Rectangle {
        x: 14.4px;
        y: 16.3px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: touch.has-hover ? #3B434C : #5C6670;
        animate background { duration: 100ms; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component StatRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: #1B1F24;
    height: 18px;

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            font-size: 12px;
            color: #5C6670;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.value;
            font-size: 12px;
            color: root.value-color;
            vertical-alignment: center;
        }
    }
}

/// A site's logo, or its initial on a tinted tile when no logo is bundled.
component SiteBadge inherits Rectangle {
    in property <image> icon;
    in property <string> initial;
    in property <color> tile-color: #5C6670;
    in property <length> badge: 22px;

    width: root.badge;
    height: root.badge;
    border-radius: 5px;
    background: icon.width > 0 ? #FFFFFF : tile-color;
    border-width: icon.width > 0 ? 1px : 0px;
    border-color: #E4E7EA;
    clip: true;

    if icon.width > 0: Image {
        width: parent.width * 0.66;
        height: parent.width * 0.66;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
    }
    if icon.width == 0: Text {
        text: root.initial;
        font-size: 10px;
        color: #FFFFFF;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TextButton inherits Rectangle {
    in property <string> label;
    in property <bool> accent: false;
    callback clicked();
    height: 24px;
    min-width: 40px;
    border-radius: 5px;
    background: touch.has-hover ? #E9EBEE : transparent;
    animate background { duration: 100ms; }

    Text {
        text: root.label;
        font-size: 12.5px;
        color: root.accent || touch.has-hover ? #0067C0 : #5C6670;
        animate color { duration: 100ms; }
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}


component PillButton inherits Rectangle {
    in property <string> label;
    in property <int> tone: 0;
    callback clicked();

    height: 28px;
    min-width: 64px;
    border-radius: 5px;
    border-width: 1px;
    border-color: tone == 1 ? #E4C7C5 : #C5D9EC;
    background: touch.has-hover
        ? (tone == 1 ? #F9ECEB : #EDF3FA)
        : #FFFFFF;
    animate background { duration: 100ms; }

    Text {
        text: root.label;
        font-size: 12px;
        color: root.tone == 1 ? #C0392B : #0067C0;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 52px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        VerticalLayout {
            width: 112px;
            alignment: center;

            Text {
                text: root.label;
                font-size: 13px;
                color: #1B1F24;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        VerticalLayout {
            alignment: center;

            Text {
                text: root.value;
                font-size: 12px;
                color: #5C6670;
            }
        }
    }
}

// -- site editor -------------------------------------------------------------

component ChoicePill inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 28px;
    min-width: 58px;
    border-radius: 5px;
    border-width: 1px;
    border-color: active ? #0067C0 : (touch.has-hover ? #BFC7CF : #D6DBE0);
    background: active ? #0067C0 : (touch.has-hover ? #F2F4F6 : #FFFFFF);
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    Text {
        text: root.label;
        font-size: 12px;
        color: root.active ? #FFFFFF : #3B434C;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// -- app window --------------------------------------------------------------

export component AppWindow inherits Window {
    title: "hakimi";
    width: 800px;
    height: 600px;
    background: #F3F4F5;

    in property <[SiteEntry]> sites;
    in property <string> status-subtitle: "正在启动";
    in property <bool> running: false;
    in-out property <int> page: 0;
    // Environment check (CA trust + system proxy). The fix page takes over the
    // window until everything passes; the main page shows a warning banner too.
    in-out property <bool> show-onboarding: false;
    // True when the page was forced by a blocked start rather than opened from
    // the warning banner; only the wording differs.
    in property <bool> fix-blocked: false;
    in property <bool> ca-installed: false;
    in property <string> ca-error;
    // Result of the last install/uninstall/repair attempt (wrong password,
    // cancelled dialog). The periodic env probe never writes this.
    in property <string> ca-action-error;
    in property <bool> ca-busy: false;
    in property <bool> proxy-ok: true;
    in-out property <bool> ob-installing: false;

    // Sidebar counters, pre-formatted by the host.
    in property <string> stat-sites: "0";
    in property <string> stat-enabled: "0";
    in property <string> stat-domains: "0";
    in property <string> stat-slow: "0";
    in property <string> stat-bad: "0";

    // Settings values, edited in place on the settings page.
    in-out property <string> cfg-proxy-port;
    in-out property <string> cfg-doh-primary;
    in-out property <string> cfg-doh-fallback;
    in-out property <string> cfg-catalog-ip;
    in-out property <string> cfg-catalog-doh;
    in property <string> cfg-data-dir;
    in property <string> cfg-version;
    in property <string> cfg-error;
    // `proxy.port` etc. — the field that produced cfg-error, so only it turns red.
    in property <string> cfg-error-key;

    // Site editor overlay.
    in-out property <bool> editor-open: false;
    in-out property <string> editor-id;
    in-out property <string> editor-name;
    in-out property <[EditorDomain]> editor-domain-rows;
    in-out property <string> editor-homepage;
    in-out property <int> editor-default-preset: 0;
    in-out property <string> editor-default-custom;
    in property <[string]> domain-route-presets: ["继承默认", "直连", "ECH", "SNI 伪装", "自定义"];
    in property <string> editor-error;
    in property <string> sites-summary;
    in-out property <bool> sites-expanded: false;
    in property <bool> editor-is-new: true;
    in property <bool> editor-deletable: false;

    callback editor-add-domain();
    callback editor-remove-domain(int);
    callback editor-domain-pattern(int, string);
    callback editor-set-domain-route(int, int);
    callback editor-domain-sni(int, string);
    callback editor-domain-custom(int, string);

    callback toggle-master();
    callback open-fix();
    callback finish-onboarding();
    callback reapply-proxy();
    callback toggle-group(string, bool);
    callback select-all(bool);
    callback probe-selected();
    callback open-site(string);
    callback toggle-open(string);
    callback settings-action(int);
    callback save-string(string, string);
    callback open-data-dir();
    callback open-editor(string);
    callback close-editor();
    callback save-editor();
    callback delete-site(string);

    VerticalLayout {
        spacing: 0px;

        // ---- toolbar ----
        if !root.show-onboarding: Rectangle {
            height: 42px;
            background: #F3F4F5;

            Rectangle {
                width: parent.width;
                height: 1px;
                y: parent.height - 1px;
                background: #E1E4E8;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 10px;
                spacing: 9px;

                Rectangle {
                    width: 28px;
                    height: parent.height;

                    if root.page == 0: Rectangle {
                        width: 20px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        background: #0067C0;

                        Path {
                            width: 11px;
                            height: 11px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            commands: "M 6.6 0.5 L 1.8 6.2 L 4.9 6.2 L 4.1 10.5 L 9.1 4.3 L 5.7 4.3 Z";
                            fill: #FFFFFF;
                        }
                    }

                    if root.page == 1: BackIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.page = 0; }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    if root.page == 0: Text {
                        text: "hakimi";
                        font-size: 13.5px;
                        font-weight: 600;
                        color: #1B1F24;
                    }
                    if root.page == 1: Text {
                        text: "设置";
                        font-size: 13.5px;
                        color: #1B1F24;
                    }
                }

                Rectangle {
                    width: 30px;
                    height: parent.height;

                    if root.page == 0: SettingsIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.page = 1; }
                    }
                }
            }
        }

        if !root.show-onboarding && root.page == 0: HorizontalLayout {
            spacing: 0px;

            // ---- left rail: state, environment, counters ----
            Rectangle {
                width: 250px;
                background: #FAFBFC;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: #E5E8EC;
                }

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 14px;
                    padding-bottom: 12px;
                    spacing: 10px;

                    Rectangle {
                        background: #FFFFFF;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #E1E4E8;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    PowerBadge {
                                        active: root.running;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: root.running ? "加速已开启" : "加速已暂停";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #1B1F24;
                                    }
                                    Text {
                                        text: root.status-subtitle;
                                        font-size: 11.5px;
                                        color: #6B7480;
                                        overflow: elide;
                                    }
                                }
                            }

                            ActionButton {
                                label: root.running ? "停止加速" : "开启加速";
                                emphasis: !root.running;
                                clicked => { root.toggle-master(); }
                            }
                        }
                    }

                    if (!root.ca-installed || !root.proxy-ok): Rectangle {
                        background: #FFF6E5;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #F0DFC0;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            Text {
                                text: "环境检查未通过，部分加速可能不生效";
                                font-size: 11.5px;
                                color: #8A6116;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: end;
                                TextButton {
                                    label: "去修复";
                                    clicked => { root.open-fix(); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #FFFFFF;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #E1E4E8;

                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            spacing: 7px;

                            Text {
                                text: "概览";
                                font-size: 11px;
                                color: #8A95A2;
                            }
                            StatRow { label: "站点"; value: root.stat-sites; }
                            StatRow { label: "已启用"; value: root.stat-enabled; }
                            StatRow { label: "域名"; value: root.stat-domains; }
                            StatRow {
                                label: "较慢";
                                value: root.stat-slow;
                                value-color: root.stat-slow == "0" ? #8A95A2 : #B88325;
                            }
                            StatRow {
                                label: "超时";
                                value: root.stat-bad;
                                value-color: root.stat-bad == "0" ? #8A95A2 : #C05B5B;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            // ---- main column: the site table ----
            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 12px;
                padding-bottom: 14px;
                spacing: 6px;

                HorizontalLayout {
                    height: 28px;
                    padding-left: 2px;

                    Text {
                        text: "站点";
                        font-size: 12.5px;
                        color: #5C6670;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TextButton { label: "检测选中"; min-width: 60px; clicked => { root.probe-selected(); } }
                    TextButton { label: "全选"; min-width: 44px; clicked => { root.select-all(true); } }
                    TextButton { label: "取消全选"; min-width: 64px; clicked => { root.select-all(false); } }
                }

                ScrollView {
                    vertical-stretch: 1;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                    VerticalLayout {
                        spacing: 0px;
                        alignment: start;

                        Rectangle {
                            border-radius: 10px;
                            background: #FFFFFF;
                            border-width: 1px;
                            border-color: #E1E4E8;
                            clip: true;

                            VerticalLayout {
                                spacing: 0px;

                                for site in root.sites: Rectangle {
                                    background: site.open ? #FAFBFC
                                        : (row-touch.has-hover ? #F4F6F8 : #FFFFFF);
                                    animate background { duration: 100ms; }

                                    VerticalLayout {
                                        spacing: 0px;

                                        // separator above the row (skip the first one)
                                        if !site.first: Rectangle {
                                            height: 1px;
                                            background: transparent;

                                            Rectangle {
                                                x: 76px;
                                                width: parent.width - 92px;
                                                height: parent.height;
                                                background: #ECEEF0;
                                            }
                                        }

                                        // row
                                        Rectangle {
                                            height: 52px;

                                            // below the layout so the checkbox and the
                                            // 访问 button keep their own clicks
                                            row-touch := TouchArea {
                                                clicked => { root.toggle-open(site.id); }
                                            }

                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 12px;
                                                spacing: 10px;

                                                Rectangle {
                                                    width: 16px;
                                                    height: parent.height;
                                                    CheckSquare {
                                                        y: (parent.height - self.height) / 2;
                                                        checked: site.enabled;
                                                        toggled => { root.toggle-group(site.id, !site.enabled); }
                                                    }
                                                }

                                                Rectangle {
                                                    width: 26px;
                                                    height: parent.height;

                                                    Rectangle {
                                                        width: 26px;
                                                        height: 26px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 6px;
                                                        background: site.icon.width > 0 ? #FFFFFF : site.tile-color;
                                                        border-width: 1px;
                                                        border-color: site.icon.width > 0 ? #E4E7EA : transparent;
                                                        clip: true;

                                                        if site.icon.width > 0: Image {
                                                            width: 17px;
                                                            height: 17px;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            source: site.icon;
                                                        }
                                                        if site.icon.width == 0: Text {
                                                            text: site.initial;
                                                            font-size: 12px;
                                                            color: #FFFFFF;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;

                                                    Text {
                                                        text: site.name;
                                                        font-size: 13px;
                                                        color: site.enabled ? #1B1F24 : #6B7480;
                                                    }
                                                    Text {
                                                        text: site.summary;
                                                        font-size: 11.5px;
                                                        color: site.summary-color;
                                                        overflow: elide;
                                                    }
                                                }

                                                Rectangle {
                                                    width: 42px;
                                                    height: parent.height;
                                                    TextButton {
                                                        width: parent.width;
                                                        y: (parent.height - self.height) / 2;
                                                        label: "访问";
                                                        clicked => { root.open-site(site.url); }
                                                    }
                                                }

                                                Rectangle {
                                                    width: 10px;
                                                    height: parent.height;
                                                    Chevron {
                                                        y: (parent.height - self.height) / 2;
                                                        open: site.open;
                                                    }
                                                }
                                            }
                                        }

                                        // expanded domains: always present, animated
                                        // between zero height and full height
                                        Rectangle {
                                            height: site.open ? site.domains.length * 26px + 1px : 0px;
                                            clip: true;
                                            background: #FAFBFC;
                                            animate height { duration: 120ms; easing: ease-out; }

                                            VerticalLayout {
                                                spacing: 0px;

                                                Rectangle { height: 1px; background: #ECEEF0; }

                                                for d in site.domains: Rectangle {
                                                    height: 26px;
                                                    background: domain-touch.has-hover ? #F1F3F5 : transparent;
                                                    animate background { duration: 100ms; }

                                                    HorizontalLayout {
                                                        // aligned under the site name column
                                                        padding-left: 76px;
                                                        padding-right: 14px;
                                                        spacing: 10px;

                                                        Text {
                                                            text: d.host;
                                                            horizontal-stretch: 1;
                                                            font-size: 11.5px;
                                                            font-family: "Menlo";
                                                            color: #3B434C;
                                                            overflow: elide;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: d.status;
                                                            width: 42px;
                                                            font-size: 11.5px;
                                                            color: d.status-color;
                                                            horizontal-alignment: right;
                                                            vertical-alignment: center;
                                                        }
                                                        Text {
                                                            text: d.latency;
                                                            width: 54px;
                                                            font-size: 11.5px;
                                                            font-family: "Menlo";
                                                            color: #6B7480;
                                                            horizontal-alignment: right;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    domain-touch := TouchArea { }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 6px; }
                    }
                }
            }
        }
        if root.show-onboarding: VerticalLayout {
            padding-top: 24px;
            padding-bottom: 24px;
            padding-left: max(24px, (root.width - 648px) / 2);
            padding-right: max(24px, (root.width - 648px) / 2);
            alignment: center;

            Rectangle {
                background: #FFFFFF;
                border-radius: 8px;
                border-width: 1px;
                border-color: #E1E4E8;

                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    Text {
                        text: root.fix-blocked ? "无法开启加速：环境检查未通过" : "环境检查未通过";
                        font-size: 17px;
                        font-weight: 600;
                        color: #1B1F24;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.fix-blocked
                            ? "为避免「看似加速实则无效」，已暂停开启。\n修复以下问题后将自动开启加速。"
                            : "修复以下问题后即可正常加速。";
                        font-size: 12.5px;
                        color: #5C6670;
                        horizontal-alignment: center;
                    }

                    Rectangle { height: 1px; background: #ECEEF0; }

                    // -- certificate trust --
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 6px;
                            background: root.ca-installed ? #E8F4EC : #EDF3FA;
                            Text {
                                text: root.ca-installed ? "✓" : "!";
                                font-size: 14px;
                                font-weight: 600;
                                color: root.ca-installed ? #1B7F4D : #0067C0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: root.ca-busy ? "等待系统授权…" : (root.ca-installed ? "证书已安装并受信任" : "本地证书未受信任");
                                font-size: 13px;
                                color: #1B1F24;
                            }
                            Text {
                                text: root.ca-busy
                                    ? "请在系统弹窗中输入密码，或取消"
                                    : (root.ca-installed ? "加速站点可以建立可信连接" : (root.ca-error != "" ? root.ca-error : "ECH / SNI 修改依赖本地证书的信任"));
                                font-size: 11.5px;
                                color: root.ca-busy ? #6B7480 : (root.ca-installed ? #6B7480 : #C0392B);
                                wrap: word-wrap;
                            }
                        }
                        Rectangle {
                            width: 96px;
                            height: 30px;
                            if !root.ca-installed: ActionButton {
                                width: parent.width;
                                y: (parent.height - self.height) / 2;
                                label: root.ca-busy ? "等待确认…" : "安装证书";
                                clicked => {
                                    root.ob-installing = true;
                                    root.settings-action(1);
                                }
                            }
                        }
                    }

                    if root.ca-action-error != "": Text {
                        text: root.ca-action-error;
                        font-size: 11.5px;
                        color: #B88325;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    Rectangle { height: 1px; background: #ECEEF0; }

                    // -- system proxy --
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 6px;
                            background: root.proxy-ok ? #E8F4EC : #EDF3FA;
                            Text {
                                text: root.proxy-ok ? "✓" : "!";
                                font-size: 14px;
                                font-weight: 600;
                                color: root.proxy-ok ? #1B7F4D : #0067C0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: root.proxy-ok ? "系统代理已写入" : "系统代理写入失败";
                                font-size: 13px;
                                color: #1B1F24;
                            }
                            Text {
                                text: root.proxy-ok ? "PAC 已写入系统；其他代理开启时可能优先生效" : "点击重新应用；其他代理开启时请先关闭";
                                font-size: 11.5px;
                                color: root.proxy-ok ? #6B7480 : #C0392B;
                            }
                        }
                        Rectangle {
                            width: 96px;
                            height: 30px;
                            if !root.proxy-ok: ActionButton {
                                width: parent.width;
                                y: (parent.height - self.height) / 2;
                                label: "重新应用";
                                clicked => { root.reapply-proxy(); }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #ECEEF0; }

                    if root.ca-installed && root.proxy-ok: VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: "✓ 环境检查已通过";
                            font-size: 13.5px;
                            color: #1B7F4D;
                            horizontal-alignment: center;
                        }
                        ActionButton {
                            width: 200px;
                            label: root.fix-blocked ? "返回加速" : "完成";
                            clicked => { root.finish-onboarding(); }
                        }
                    }

                    TextButton {
                        label: "暂不处理，返回主页";
                        clicked => { root.finish-onboarding(); }
                    }
                }
            }
        }

        if !root.show-onboarding && root.page == 1: VerticalLayout {
            // Keep the settings column readable on a wide desktop window.
            padding-left: max(20px, (root.width - 660px) / 2);
            padding-right: max(20px, (root.width - 660px) / 2);
            padding-bottom: 16px;
            padding-top: 14px;

            settings-scroll := ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                // Pin the content to the viewport: letting it size from its
                // children made every `parent.width` inside the cards fall back
                // to the preferred width (409px), which clipped the dividers.
                VerticalLayout {
                    width: settings-scroll.content-width;
                    spacing: 12px;
                    alignment: start;

                    // ---- 站点 ----
                    Rectangle {
                        border-radius: 8px;
                        background: #FFFFFF;
                        border-width: 1px;
                        border-color: #E1E4E8;
                        clip: true;

                        VerticalLayout {
                            spacing: 0px;

                            Rectangle {
                                height: 52px;
                                background: sites-head-touch.has-hover ? #F7F8F9 : #FFFFFF;
                                animate background { duration: 100ms; }

                                sites-head-touch := TouchArea {
                                    clicked => { root.sites-expanded = !root.sites-expanded; }
                                }

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 14px;
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "站点管理";
                                            font-size: 13.5px;
                                            color: #3B434C;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: root.sites-summary;
                                            font-size: 12px;
                                            color: #6B7480;
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    VerticalLayout {
                                        alignment: center;
                                        PillButton {
                                            label: "+ 添加站点";
                                            min-width: 86px;
                                            clicked => { root.open-editor(""); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Chevron { open: root.sites-expanded; }
                                    }
                                }
                            }

                            if root.sites-expanded: VerticalLayout {
                                spacing: 0px;

                                Rectangle {
                                    height: 1px;
                                    background: transparent;

                                    Rectangle {
                                        x: 16px;
                                        width: parent.width - 32px;
                                        height: 1px;
                                        background: #ECEEF0;
                                    }
                                }

                                for site in root.sites: VerticalLayout {
                                    spacing: 0px;

                                    if !site.first: Rectangle {
                                        height: 1px;
                                        background: transparent;

                                        Rectangle {
                                            x: 16px;
                                            width: parent.width - 32px;
                                            height: 1px;
                                            background: #ECEEF0;
                                        }
                                    }

                                    Rectangle {
                                        height: 48px;
                                        background: site-touch.has-hover ? #F7F8F9 : transparent;
                                        animate background { duration: 100ms; }

                                        site-touch := TouchArea {
                                            clicked => { root.open-editor(site.id); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 14px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                alignment: center;
                                                SiteBadge {
                                                    badge: 24px;
                                                    icon: site.icon;
                                                    initial: site.initial;
                                                    tile-color: site.tile-color;
                                                }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 1px;

                                                Text {
                                                    text: site.name;
                                                    font-size: 13.5px;
                                                    font-weight: 500;
                                                    color: site.enabled ? #1B1F24 : #6B7480;
                                                }
                                                Text {
                                                    text: site.summary;
                                                    font-size: 11.5px;
                                                    color: site.summary-color;
                                                    overflow: elide;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Chevron { open: false; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- 证书 ----
                    Text {
                        text: "证书";
                        font-size: 12.5px;
                        color: #5C6670;
                    }
                    Rectangle {
                        border-radius: 8px;
                        background: #FFFFFF;
                        border-width: 1px;
                        border-color: #E1E4E8;

                        VerticalLayout {
                            spacing: 0px;

                        HorizontalLayout {
                            height: 58px;
                            padding-left: 16px;
                            padding-right: 14px;
                            spacing: 12px;

                            VerticalLayout {
                                width: 112px;
                                alignment: center;
                                Text {
                                    text: "本地 CA";
                                    font-size: 13px;
                                    color: #1B1F24;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: root.ca-busy ? "处理中…" : (root.ca-installed ? "已安装并受信任" : "未受信任");
                                    font-size: 12px;
                                    color: root.ca-busy ? #5C6670 : (root.ca-installed ? #1B7F4D : #C0392B);
                                }
                                Text {
                                    text: root.ca-busy
                                        ? "等待系统授权，完成前不会改判状态"
                                        : (root.ca-installed ? "ECH / SNI 修改可用" : (root.ca-error != "" ? root.ca-error : "ECH / SNI 修改会失败"));
                                    font-size: 11px;
                                    color: #8A95A2;
                                    overflow: elide;
                                }
                            }

                            Rectangle {
                                width: 152px;
                                height: parent.height;

                                HorizontalLayout {
                                    y: (parent.height - self.height) / 2;
                                    height: 28px;
                                    spacing: 8px;
                                    alignment: end;

                                    if root.ca-installed: PillButton {
                                        label: "移除";
                                        tone: 1;
                                        clicked => { root.settings-action(2); }
                                    }
                                    PillButton {
                                        label: root.ca-busy ? "处理中…" : (root.ca-installed ? "修复" : "安装");
                                        clicked => { root.settings-action(root.ca-installed ? 3 : 1); }
                                    }
                                }
                            }
                        }

                        // Result of the last attempt: a wrong keychain password or a
                        // cancelled dialog lands here instead of vanishing.
                        if root.ca-action-error != "": Rectangle {
                            height: 1px;
                            background: transparent;

                            Rectangle {
                                x: 16px;
                                width: parent.width - 32px;
                                height: 1px;
                                background: #ECEEF0;
                            }
                        }
                        if root.ca-action-error != "": Rectangle {
                            min-height: 32px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 14px;
                                padding-top: 8px;
                                padding-bottom: 8px;

                                Text {
                                    text: root.ca-action-error;
                                    font-size: 11.5px;
                                    color: #B88325;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        }
                    }

                    // ---- 网络 ----
                    Text {
                        text: "网络";
                        font-size: 12.5px;
                        color: #5C6670;
                    }
                    Rectangle {
                        border-radius: 8px;
                        background: #FFFFFF;
                        border-width: 1px;
                        border-color: #E1E4E8;

                        VerticalLayout {
                            spacing: 0px;

                            FieldRow {
                                label: "监听端口";
                                hint: "重启后生效";
                                setting-key: "proxy.port";
                                error-key: root.cfg-error-key;
                                placeholder: "8443";
                                text <=> root.cfg-proxy-port;
                                commit(value) => { root.save-string("proxy.port", value); }
                            }
                            RowLine { }
                            FieldRow {
                                label: "主加密 DNS";
                                hint: "HTTPS DoH 端点";
                                setting-key: "doh.primary";
                                error-key: root.cfg-error-key;
                                placeholder: "https://…";
                                text <=> root.cfg-doh-primary;
                                commit(value) => { root.save-string("doh.primary", value); }
                            }
                            RowLine { }
                            FieldRow {
                                label: "备用 DNS";
                                hint: "主端点不可用时回退";
                                setting-key: "doh.fallback";
                                error-key: root.cfg-error-key;
                                placeholder: "https://…";
                                text <=> root.cfg-doh-fallback;
                                commit(value) => { root.save-string("doh.fallback", value); }
                            }
                        }
                    }

                    // ---- 目录 ----
                    Text {
                        text: "目录";
                        font-size: 12.5px;
                        color: #5C6670;
                    }
                    Rectangle {
                        border-radius: 8px;
                        background: #FFFFFF;
                        border-width: 1px;
                        border-color: #E1E4E8;

                        VerticalLayout {
                            spacing: 0px;

                            FieldRow {
                                label: "IP 目录";
                                hint: "留空则停用远程 IP";
                                setting-key: "catalogs.ip";
                                error-key: root.cfg-error-key;
                                placeholder: "https://…";
                                text <=> root.cfg-catalog-ip;
                                commit(value) => { root.save-string("catalogs.ip", value); }
                            }
                            RowLine { }
                            FieldRow {
                                label: "DoH 目录";
                                hint: "留空则停用远程 DoH 列表";
                                setting-key: "catalogs.doh";
                                error-key: root.cfg-error-key;
                                placeholder: "https://…";
                                text <=> root.cfg-catalog-doh;
                                commit(value) => { root.save-string("catalogs.doh", value); }
                            }
                        }
                    }

                    // ---- 数据 ----
                    Text {
                        text: "数据";
                        font-size: 12.5px;
                        color: #5C6670;
                    }
                    Rectangle {
                        border-radius: 8px;
                        background: #FFFFFF;
                        border-width: 1px;
                        border-color: #E1E4E8;

                        VerticalLayout {
                            spacing: 0px;

                            Rectangle {
                                height: 52px;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 14px;
                                    spacing: 12px;

                                    VerticalLayout {
                                        width: 112px;
                                        alignment: center;
                                        Text {
                                            text: "数据目录";
                                            font-size: 13px;
                                            color: #1B1F24;
                                        }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.cfg-data-dir;
                                        font-size: 11.5px;
                                        font-family: "Menlo";
                                        color: #6B7480;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        width: 64px;
                                        height: parent.height;
                                        PillButton {
                                            width: parent.width;
                                            y: (parent.height - self.height) / 2;
                                            label: "打开";
                                            clicked => { root.open-data-dir(); }
                                        }
                                    }
                                }
                            }

                            RowLine { }

                            InfoRow {
                                label: "版本";
                                value: root.cfg-version;
                            }
                        }
                    }

                    if root.cfg-error != "": Rectangle {
                        border-radius: 6px;
                        background: #FBE9E7;
                        border-width: 1px;
                        border-color: #E4C7C5;
                        height: 36px;

                        Text {
                            x: 12px;
                            width: parent.width - 24px;
                            text: root.cfg-error;
                            font-size: 11.5px;
                            color: #C0392B;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
    // ---- site editor ----
    if root.editor-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: rgba(15, 18, 22, 0.30);

        // swallow clicks so the list underneath does not react
        TouchArea { }

        card := Rectangle {
            width: 560px;
            height: parent.height - 40px > 620px ? 620px : parent.height - 40px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #FFFFFF;
            border-radius: 12px;
            border-width: 1px;
            border-color: #DDE2E7;
            drop-shadow-blur: 28px;
            drop-shadow-color: rgba(15, 18, 22, 0.22);
            drop-shadow-offset-y: 10px;

            VerticalLayout {
                body := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;

                        Text {
                            text: root.editor-is-new ? "添加站点" : "编辑站点";
                            font-size: 19px;
                            font-weight: 600;
                            color: #1B1F24;
                        }

                Text {
                    text: "名称与访问地址";
                    font-size: 12.5px;
                    font-weight: 600;
                    color: #4B5563;
                }

                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "名称";
                        font-size: 12px;
                        color: #4B5563;
                    }
                    FormInput {
                        text <=> root.editor-name;
                        placeholder: "例如 Pixiv";
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "访问地址（可选）";
                        font-size: 12px;
                        color: #4B5563;
                    }
                    FormInput {
                        text <=> root.editor-homepage;
                        placeholder: "例如 https://www.example.com/，留空使用第一个域名";
                    }
                }

                Text {
                    text: "域名与线路";
                    font-size: 12.5px;
                    font-weight: 600;
                    color: #4B5563;
                }
                Text {
                    text: "每个域名单独选择线路。点击右侧的线路选择器即可切换，不需要手写线路语法。";
                    font-size: 11.5px;
                    color: #6B7480;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: 10px;
                    for row[i] in root.editor-domain-rows: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            FormInput {
                                horizontal-stretch: 1;
                                text: row.pattern;
                                placeholder: "example.com 或 *.example.com";
                                edited(text) => { root.editor-domain-pattern(i, text); }
                            }
                            RouteSelect {
                                label: row.route-label;
                                current: row.route;
                                model: root.domain-route-presets;
                                selected(index) => {
                                    root.editor-set-domain-route(i, index);
                                }
                            }
                            if root.editor-domain-rows.length > 1: VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: "移除";
                                    min-width: 44px;
                                    clicked => {
                                        root.editor-remove-domain(i);
                                    }
                                }
                            }
                        }
                        if row.route == 3: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "伪装 SNI 主机";
                                font-size: 11.5px;
                                color: #6B7480;
                            }
                            FormInput {
                                text: row.sni;
                                placeholder: "多个用逗号分隔；留空使用默认候选";
                                edited(text) => { root.editor-domain-sni(i, text); }
                            }
                        }
                        if row.route == 4: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "自定义线路";
                                font-size: 11.5px;
                                color: #6B7480;
                            }
                            FormInput {
                                text: row.custom;
                                placeholder: "例如 ech+direct";
                                edited(text) => { root.editor-domain-custom(i, text); }
                            }
                        }
                    }
                }

                TextButton {
                    label: "+ 添加域名";
                    accent: true;
                    min-width: 100px;
                    clicked => {
                        root.editor-add-domain();
                    }
                }

                Text {
                    text: "站点默认线路";
                    font-size: 12.5px;
                    font-weight: 600;
                    color: #4B5563;
                }
                Text {
                    text: "没有单独设置线路的域名会使用它。";
                    font-size: 11.5px;
                    color: #6B7480;
                }
                HorizontalLayout {
                    spacing: 6px;
                    ChoicePill {
                        label: "自动";
                        horizontal-stretch: 1;
                        active: root.editor-default-preset == 0;
                        clicked => { root.editor-default-preset = 0; }
                    }
                    ChoicePill {
                        label: "直连";
                        horizontal-stretch: 1;
                        active: root.editor-default-preset == 1;
                        clicked => { root.editor-default-preset = 1; }
                    }
                    ChoicePill {
                        label: "ECH";
                        horizontal-stretch: 1;
                        active: root.editor-default-preset == 2;
                        clicked => { root.editor-default-preset = 2; }
                    }
                    ChoicePill {
                        label: "SNI 伪装";
                        horizontal-stretch: 1;
                        active: root.editor-default-preset == 3;
                        clicked => { root.editor-default-preset = 3; }
                    }
                    ChoicePill {
                        label: "自定义";
                        horizontal-stretch: 1;
                        active: root.editor-default-preset == 4;
                        clicked => { root.editor-default-preset = 4; }
                    }
                }

                if root.editor-default-preset == 4: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "自定义默认线路（高级）";
                        font-size: 12px;
                        color: #4B5563;
                    }
                    FormInput {
                        text <=> root.editor-default-custom;
                        placeholder: "例如 ech+direct 或 sni:www.baidu.com+direct";
                    }
                }
                    }
                }

                Rectangle { height: 1px; background: #ECEEF0; }

                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 12px;
                    padding-bottom: 16px;
                    spacing: 10px;

                    if root.editor-error != "": Text {
                        text: root.editor-error;
                        font-size: 12px;
                        color: #C0392B;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        if root.editor-deletable: PillButton {
                            label: "删除站点";
                            tone: 1;
                            clicked => { root.delete-site(root.editor-id); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TextButton {
                            label: "取消";
                            min-width: 52px;
                            clicked => { root.close-editor(); }
                        }
                        ActionButton {
                            label: "保存";
                            clicked => { root.save-editor(); }
                        }
                    }
                }
            }
        }
    }
}

// System tray: Slint requires the tray to be the root of an exported component
// (never a child of the window). While this icon is visible the event loop
// stays alive, so closing the window parks the app here instead of quitting.
// The toggle title is property-driven so it follows the running state.
export component TrayRoot inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.png");
    tooltip: "hakimi";
    in property <bool> running: false;
    callback show-main();
    callback toggle-master();
    callback probe-selected();
    callback quit();
    clicked => { root.show-main(); }
    Menu {
        MenuItem {
            title: "显示主窗口";
            activated => { root.show-main(); }
        }
        MenuSeparator {}
        MenuItem {
            title: root.running ? "停止加速" : "开启加速";
            activated => { root.toggle-master(); }
        }
        MenuItem {
            title: "检测选中";
            activated => { root.probe-selected(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "退出";
            activated => { root.quit(); }
        }
    }
}
