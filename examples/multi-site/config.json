{
  "doh": {
    "primary": "https://doh.cleanbrowsing.org/doh/security-filter/",
    "fallback": "https://doh.applied-privacy.net/query",
    "custom": []
  },
  "catalogs": {
    "ip": "http://127.0.0.1:18470/ips.json",
    "doh": "http://127.0.0.1:18470/doh.json",
    "ipMirrors": [],
    "dohMirrors": [],
    "signaturePublicKey": null,
    "signatureUrl": null,
    "refreshHours": 6,
    "timeoutSecs": 5
  },
  "proxy": {
    "mode": "off",
    "port": 18472,
    "bind": "127.0.0.1",
    "takeover": false
  },
  "groups": [
    {
      "id": "ao3",
      "name": "AO3",
      "domains": [
        { "pattern": "archiveofourown.org" },
        { "pattern": "www.archiveofourown.org" },
        { "pattern": "*.archiveofourown.org" }
      ],
      "enabled": true,
      "defaultRoute": {
        "attempts": [
          { "mode": "sni" },
          { "mode": "direct" }
        ]
      }
    },
    {
      "id": "github",
      "name": "GitHub",
      "domains": [
        { "pattern": "github.com" },
        { "pattern": "api.github.com" },
        { "pattern": "codeload.github.com" },
        { "pattern": "gist.github.com", "route": { "attempts": [{ "mode": "sni", "sni": ["api.github.com"] }, { "mode": "direct" }] } },
        { "pattern": "raw.githubusercontent.com" },
        { "pattern": "*.githubusercontent.com" },
        { "pattern": "*.githubassets.com" }
      ],
      "enabled": true,
      "defaultRoute": {
        "attempts": [
          { "mode": "sni" },
          { "mode": "direct" }
        ]
      }
    },
    {
      "id": "pixiv",
      "name": "Pixiv",
      "domains": [
        { "pattern": "pixiv.net", "route": { "attempts": [{ "mode": "ech", "ech": "shared" }, { "mode": "direct" }] } },
        { "pattern": "www.pixiv.net", "route": { "attempts": [{ "mode": "ech", "ech": "shared" }, { "mode": "direct" }] } },
        { "pattern": "*.pixiv.net", "route": { "attempts": [{ "mode": "ech", "ech": "shared" }, { "mode": "direct" }] } },
        { "pattern": "i.pximg.net" },
        { "pattern": "s.pximg.net" },
        { "pattern": "booth.pximg.net" },
        { "pattern": "*.pximg.net" }
      ],
      "enabled": true,
      "defaultRoute": { "attempts": [{ "mode": "sni" }, { "mode": "direct" }] }
    },
    {
      "id": "poipiku",
      "name": "Poipiku",
      "domains": [
        {
          "pattern": "poipiku.com",
          "route": { "attempts": [{ "mode": "sni", "sni": [""] }, { "mode": "direct" }] }
        },
        { "pattern": "img.poipiku.com" },
        { "pattern": "cdn.poipiku.com" },
        { "pattern": "*.poipiku.com" }
      ],
      "enabled": true,
      "defaultRoute": { "attempts": [{ "mode": "direct" }] }
    },
    {
      "id": "steam",
      "name": "Steam",
      "domains": [
        { "pattern": "store.steampowered.com" },
        { "pattern": "steamcommunity.com" },
        { "pattern": "*.steamcommunity.com" },
        { "pattern": "*.steampowered.com" },
        { "pattern": "*.steamstatic.com" },
        { "pattern": "steamcdn-a.akamaihd.net" }
      ],
      "enabled": true,
      "defaultRoute": {
        "attempts": [
          { "mode": "sni" },
          { "mode": "direct" }
        ]
      }
    }
  ],
  "catalogVersion": 0,
  "advanced": {
    "fakeSniCandidates": [
      "",
      "www.baidu.com",
      "www.cloudflare.com",
      "www.bing.com",
      "www.apple.com"
    ],
    "maxCandidatesPerDomain": 8,
    "ipTimeoutMs": 2000,
    "lastGoodDays": 7,
    "prewarm": true,
    "prewarmConcurrency": 8,
    "planCacheSecs": 600,
    "upstreamIdleSecs": 300,
    "upstreamMaxIdlePerHost": 16,
    "http1Hosts": [
      "*.pximg.net",
      "img.poipiku.com",
      "cdn.poipiku.com"
    ],
    "http1MaxConcurrent": 32
  },
  "log": {
    "level": "info"
  }
}
