{
  "doh": {
    "primary": "https://doh.cleanbrowsing.org/doh/security-filter/",
    "fallback": "https://doh.applied-privacy.net/query",
    "custom": []
  },
  "catalogs": {
    "ip": "http://127.0.0.1:18470/ips.json",
    "doh": "http://127.0.0.1:18470/doh.json",
    "ipMirrors": [],
    "dohMirrors": [],
    "signaturePublicKey": null,
    "signatureUrl": null,
    "refreshHours": 6,
    "timeoutSecs": 5
  },
  "proxy": {
    "mode": "pac",
    "port": 18471,
    "bind": "127.0.0.1",
    "takeover": false
  },
  "groups": [
    {
      "id": "ao3",
      "name": "AO3",
      "domains": [
        { "pattern": "archiveofourown.org" },
        { "pattern": "www.archiveofourown.org" },
        { "pattern": "*.archiveofourown.org" }
      ],
      "enabled": true,
      "defaultRoute": {
        "attempts": [
          { "mode": "sni" },
          { "mode": "direct" }
        ]
      }
    }
  ],
  "catalogVersion": 0,
  "advanced": {
    "fakeSniCandidates": [
      "",
      "www.baidu.com",
      "www.cloudflare.com",
      "www.bing.com",
      "www.apple.com"
    ],
    "maxCandidatesPerDomain": 8,
    "ipTimeoutMs": 2000,
    "lastGoodDays": 7,
    "maxParallelProbes": 4
  },
  "log": {
    "level": "info"
  }
}
